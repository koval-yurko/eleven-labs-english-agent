{"nodes": [{"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider", "label": "Vapi MCP on the third provider", "file_type": "document", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vapi accepts an inline MCP tool in model.tools, so it is the cheapest provider to grant: no second remote object, no approval, no allowlist.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_inline_model_tools", "label": "Inline model.tools decision", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stored tool would add a second remote object with its own id, hash, lockfile entry and delete-ordering problem; inline puts the tool block inside vapiHash.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_mcp_token_plaintext", "label": "MCP_TOKEN stored in the assistant in the clear", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vapi's public API has no credential endpoints, so the token goes in server.headers.Authorization; GET returns it verbatim, which argues for a later credentialId upgrade.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_skip_on_missing_token", "label": "Missing token skips Vapi provider", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The token is in the hashed body, so syncing without it would PATCH a live assistant with an empty Bearer and every tool call would 401 silently.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_mcpserverids_bug", "label": "mcpServerIds applied to every driver bug", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mcpServerIds is ElevenLabs-only, but buildPlan applied it to all drivers, which would cause an endless PATCH loop once words-3.1 existed.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_words_3_1", "label": "words-3.1 prompt version", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new module rather than an edit to 3.0 keeps words-1.0, 2.0 and 3.0 byte-identical so cross-service comparison stays meaningful.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_anonymous_owner", "label": "MCP saves are anonymous (owner_id NULL)", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_28_openai_realtime_mcp_tools", "label": "OpenAI Realtime MCP tools doc", "file_type": "document", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code", "label": "ElevenLabs MCP in code doc", "file_type": "document", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationa
{"nodes": [{"id": "docs_2026_07_26_light_theme_reverts_to_dark_on_navigation", "label": "Light theme reverts to Dark on navigation (hydration mismatch)", "file_type": "document", "source_file": "docs/2026-07-26-light-theme-reverts-to-dark-on-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root cause is a React #418 hydration text mismatch from toLocaleDateString in client components (server UTC vs browser timezone); it drops data-theme and ThemeToggle then overwrites localStorage.", "_origin": "semantic"}, {"id": "docs_2026_07_26_light_theme_reverts_to_dark_on_navigation_format_date", "label": "formatDate() pinned-format helper", "file_type": "concept", "source_file": "docs/2026-07-26-light-theme-reverts-to-dark-on-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinning en-US and UTC chosen over suppressHydrationWarning or post-mount formatting because audit dates tolerate a day's offset and one call kills the bug class.", "_origin": "semantic"}, {"id": "docs_2026_07_26_light_theme_reverts_to_dark_on_navigation_theme_toggle_fix", "label": "ThemeToggle reads storage not DOM", "file_type": "concept", "source_file": "docs/2026-07-26-light-theme-reverts-to-dark-on-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes the theme non-corruptible: a hydration failure becomes a brief flash instead of a permanently destroyed preference.", "_origin": "semantic"}], "edges": [{"source": "docs_2026_07_26_light_theme_reverts_to_dark_on_navigation", "target": "docs_2026_07_26_light_theme_reverts_to_dark_on_navigation_format_date", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-26-light-theme-reverts-to-dark-on-navigation.md", "source_location": null, "weight": 1
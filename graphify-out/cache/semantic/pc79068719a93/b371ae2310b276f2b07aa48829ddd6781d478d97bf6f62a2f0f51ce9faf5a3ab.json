{"nodes": [{"id": "docs_2026_08_12_expo_app_creation", "label": "Expo app \u2014 full native port (creation doc)", "file_type": "document", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A browser tab cannot hold a voice session when the phone locks: iOS revokes the mic and drops the socket when Safari leaves the foreground.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_api_v2", "label": "/api/v2/* endpoint surface", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native-only endpoints live under /api/v2 so the Bearer-token path never runs for the web app; structurally enforces D4 (web app unchanged).", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_token_route", "label": "words-agent token route (WebRTC conversation token)", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Native throws on signedUrl/websocket, so a v2 route calls /v1/convai/conversation/token; agentId is not sent from the app so sync:agents can retire versions without breaking installed binaries.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_blocker_b1", "label": "B1 \u2014 Auth0 bearer on device", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a verification-only AUTH0_API_AUDIENCE rather than AUTH0_AUDIENCE so the web login flow stays byte-for-byte unchanged.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_blocker_b2", "label": "B2 \u2014 backgrou
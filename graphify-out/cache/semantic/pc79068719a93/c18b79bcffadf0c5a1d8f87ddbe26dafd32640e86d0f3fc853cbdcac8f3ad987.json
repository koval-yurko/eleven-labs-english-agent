{"nodes": [{"id": "docs_2026_08_15_word_autocomplete_suggestions", "label": "Word autocomplete suggestions", "file_type": "document", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_lexicon_table", "label": "lexicon Postgres table", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-side shared reference data (not owner-scoped) so dictionary fixes don't need App Store releases; key computed by lesson_item_norm_key so owned join is exact.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_llm_level_pass", "label": "D2: LLM batch level pass over lexicon", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CEFR lists cover ~15% of corpus; frequency inference was only 39% exact; Opus 5 scored 50%/93% against the human-graded eval set and Haiku only matched frequency.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_suggest_route", "label": "GET /api/v2/lexicon/suggest", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Behind withBearer because owned joins against the caller's collection; degenerate inputs return 200 with empty array.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_autocomplete_component", "label": "Autocomplete component (@/ui)", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selection fills the input and never submits so mis-taps stay recoverable and the write path is unchanged.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_bucket_cache", "label": "Prefix-bucket cache", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A partial local slice showed the wrong top-8 60% of the time; caching the complete bucket for the first two characters gives exact results with 88% fewer requests.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_lexicon_prefix_fold", "label": "lexiconPrefixFold", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "clientDedupeKey doesn't unaccent; the fold narrows a list but never decides identity and fails safe.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_lexicon_levels", "label": "LexiconLevel (A1\u2013C2) vs CefrLevel", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two vocabularies for two questions; widening CEFR_LEVELS would widen the items filter grammar for a level nothing can be filtered to.", "_origin": "semantic"}], "edges": [{"source": "docs_2026_08_15_word_autocomplete_suggestions", "target": "docs_2026_08_15_word_autocomplete_suggestions_lexicon_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-15-word-autocomplete-suggesti
{"nodes": [{"id": "docs_2026_08_16_background_controls_lock_screen", "label": "Background controls \u2014 lock screen", "file_type": "document", "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_16_background_controls_lock_screen_live_activity", "label": "Live Activity + App Intents surface", "file_type": "concept", "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Now Playing has no mute command and no word list, so Live Activity with interactive buttons (iOS 17) is the fitting surface.", "_origin": "semantic"}, {"id": "docs_2026_08_16_background_controls_lock_screen_single_writer", "label": "Single-writer rule (Swift posts intent, JS owns state)", "file_type": "concept", "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Silencing the tutor is a feature-detected reach in JS, setMuted throws without a conversation, and resume logic would fork the tutor wire contract if reimplemented in Swift.", "_origin": "semantic"}, {"id": "docs_2026_08_16_background_controls_lock_screen_phase_state_machine", "label": "live/muted/held state machine", "file_type": "concept", "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pause implies mute, so resume must restore the learner's prior mute rather than overriding it.", "_origin": "semantic"}, {"id": "docs_2026_08_16_background_controls_lock_screen_intent_inbox", "label": "App Group intent inbox + Darwin notification", "file_type": "concept", "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Taps must not be lost if the RN runtime is down; Darwin notification crosses process boundaries so which process runs the intent stops mattering.", "_origin": "semantic"}, {"id": "docs_2026_08_16_background_controls_lock_screen_shared_swift_sources", "label": "Shared Swift sources via podspec mirroring", "file_type": "concept", "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CocoaPods silently drops globs outside the pod root, so the podspec mirrors the files from the single copy at pod install and the mirror is gitignored.", "_origin": "semantic"}, {"id": "docs_2026_08_16_background_controls_lock_screen_apple_targets", "label": "@bacons/apple-targets widget extension", "file_type": "concept", "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "entitlements: {} is load-bearing so the App Group is mirrored into the extension's provisioning.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line", "label": "Tutor pause: hold the line (referenced doc)", "file_type": "document", "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}], "edges": [{"source": "docs_2026_08_16_background_controls_lock_screen", "target": "docs_2026_08_16_tutor_pause_hold_the_line", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-16-background-controls-lock-screen.md", "source_location": null, "weight": 1, "_origin": "
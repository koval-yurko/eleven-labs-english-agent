{"nodes": [{"id": "docs_2026_08_18_collection_and_lessons_list_fixes", "label": "Four fixes on lessons list and collection", "file_type": "document", "source_file": "docs/2026-08-18-collection-and-lessons-list-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_18_collection_and_lessons_list_fixes_default_title", "label": "Default lesson title fix", "file_type": "concept", "source_file": "docs/2026-08-18-collection-and-lessons-list-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server guard went into createLesson rather than applyOp so no caller can write a blank title.", "_origin": "semantic"}, {"id": "docs_2026_08_18_collection_and_lessons_list_fixes_hard_delete_word", "label": "Hard delete of a word", "file_type": "concept", "source_file": "docs/2026-08-18-collection-and-lessons-list-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soft delete would collide with unique(owner_id, norm_key) and resolve_words, requiring changes to four views and the RPC; the FK cascade was written for hard delete.", "_origin": "semantic"}, {"id": "docs_2026_08_18_collection_and_lessons_list_fixes_post_delete_route", "label": "POST /api/v2/lesson-items/delete", "file_type": "code", "source_file": "docs/2026-08-18-collection-and-lessons-list-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST chosen over DELETE because CORS allow-methods is GET,POST,OPTIONS and DELETE would fail preflight under expo start --web.", "_origin": "semantic"}, {"id": "docs_2026_08_18_collection_and_lessons_list_fixes_screen_footer", "label": "Screen footer slot (pinned selection bar)", "file_type": "concept", "source_file": "docs/2026-08-18-co
{"nodes": [{"id": "docs_2026_08_16_tutor_pause_hold_the_line", "label": "Pause by holding the line open", "file_type": "document", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconnecting can never resume exactly (a new conversation fights the re-injected prompt); holding the line cannot fail to, since the agent's context stays intact.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line_heartbeat", "label": "user_activity heartbeat", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "user_activity resets turn_timeout, keeping the agent from re-engaging into silence; contextual_update does not reset it and accretes in context.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line_setvolume_noop", "label": "setVolume no-op on React Native (F8)", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The audio adapter is registered only by the web entrypoint, so the call silently does nothing; silencing goes through LiveKit remote tracks in agent-audio.ts.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line_agent_audio", "label": "apps/mobile/src/lib/agent-audio.ts", "file_type": "code", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line_lesson_state", "label": "{{lesson_state}} dynamic variable plan (words-1.4)", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carry lesson state, not a chat log; a dynamic variable lands in the system prompt at the same strength as the instruction it must override.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line_grace_timer", "label": "Grace timer escalation (not built)", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not built because escalating calls endSession, the lossy path that prompted the document; involuntary exits already exist.", "_origin": "semantic"}], "edges": [{"source": "docs_2026_08_16_tutor_pause_hold_the_line", "target": "docs_2026_08_16_tutor_session_pause_resume", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_16_tutor_pause_hold_the_line", "target": "docs_2026_08_16_tutor_pause_hold_the_line_heartbeat", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_16_tutor_pause_hold_the_line", "target": "docs_2026_08_16_tutor_pause_hold_the_line_setvolume_noop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_16_tutor_pause_hold_the_line_setvolume_noop", "target": "docs_2026_08_16_tutor_pause_hold_the_line_agent_audio", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "sourc
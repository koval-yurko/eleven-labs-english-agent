{"nodes": [{"id": "docs_2026_10_22_livekit_reply_stops_early", "label": "LiveKit: tutor stops after one or two words", "file_type": "document", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_10_22_livekit_reply_stops_early_turn_ledger", "label": "livekit_turn_ledger", "file_type": "concept", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transcripts are cut at 4,000 chars per line by sanitizeTranscript, so the worker ledger is the reliable evidence of what Claude generated vs. what was heard.", "docs_note": null, "_origin": "semantic"}, {"id": "docs_2026_10_22_livekit_reply_stops_early_qwen_tts", "label": "qwen-tts.ts", "file_type": "code", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A task-finished received before finish-task was treated as success, silently dropping unsent text; now the rest is sent on a new task (up to 20 times) and flagged as tts:early-finish.", "_origin": "semantic"}, {"id": "docs_2026_10_22_livekit_reply_stops_early_save_words_tool", "label": "save-words-tool.ts", "file_type": "code", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tool description now carries the clause's rules because words-4.x prompts lack SAVE_TO_COLLECTION_CLAUSE; it is the only guard those versions have.", "_origin": "semantic"}, {"id": "docs_2026_10_22_livekit_reply_stops_early_words_4_1", "label": "words-4.1 prompt", "file_type": "concept", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its first reply is the whole lesson (about 10k chars), so a mid-reply audio stop makes the model believe the lesson was completed.", "_origin": "semantic"}, {"id": "docs_2026_10_22_livekit_reply_stops_early_words_4_2", "label": "words-4.2 prompt", "file_type": "concept", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks for ~45 s chunks and continues with autoContinue; recommended version, but promoting it to default is a separate decision.", "_origin": "semantic"}, {"id": "docs_2026_10_22_livekit_reply_stops_early_sanitize_transcript", "label": "sanitizeTranscript", "file_type": "code", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_10_22_livekit_reply_stops_early_add_words_to_collection", "label": "add_words_to_collection tool call", "file_type": "concept", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_10_22_livekit_reply_stops_early_early_finish_hypothesis", "label": "Early task-finished hypothesis (unproven)", "file_type": "concept", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not proven: the Qwen key is only in LiveKit Cloud secrets and lk agent logs was unavailable, so the server-side reason is unknown.", "_origin": "semantic"}, {"id": "docs_2026_10_09_qwen_tts_latency_and_rate_limits", "label": "Qwen TTS latency and rate limits doc", "file_type": "document", "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}], "edges": [{"source": "docs_2026_10_22_livekit_reply_stops_early", "target": "docs_2026_10_22_livekit_reply_stops_early_turn_ledger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_10_22_livekit_reply_stops_early", "target": "docs_2026_10_22_livekit_reply_stops_early_qwen_tts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_10_22_livekit_reply_stops_early", "target": "docs_2026_10_22_livekit_reply_stops_early_save_words_tool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_10_22_livekit_reply_stops_early", "target": "docs_2026_10_22_livekit_reply_stops_early_words_4_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_10_22_livekit_reply_stops_early", "target": "docs_2026_10_22_livekit_reply_stops_early_words_4_2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-10-22-livekit-reply-stops-early.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_10_22_livekit_reply_stops_early", "target": "docs_2026_10_22_livekit_reply_stops_early_sanitize_transc
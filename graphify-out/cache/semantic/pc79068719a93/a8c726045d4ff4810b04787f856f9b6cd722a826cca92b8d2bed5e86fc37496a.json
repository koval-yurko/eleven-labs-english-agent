{"nodes": [{"id": "docs_2026_08_17_short_turns_and_chunked_pause", "label": "Short turns and a chunked pause", "file_type": "document", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pause cannot be finer than one agent turn because the client cannot abort a turn; the fix is making turns small, aborting in flight, and restating a chunk.", "_origin": "semantic"}, {"id": "docs_2026_08_17_short_turns_and_chunked_pause_pause_stop_message", "label": "PAUSE_STOP_MESSAGE barge-in (L5)", "file_type": "concept", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "user_message triggers the same response flow as speech, so a hidden stop token barges in and ends the in-flight turn.", "_origin": "semantic"}, {"id": "docs_2026_08_17_short_turns_and_chunked_pause_next_chunk_tool", "label": "next_chunk client tool (L4, not built)", "file_type": "concept", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes pause land at a chunk boundary and gives the app real lesson state; costs a second reconciled resource type in the sync script.", "_origin": "semantic"}, {"id": "docs_2026_08_17_short_turns_and_chunked_pause_words_1_4", "label": "words-1.4 prompt version", "file_type": "concept", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One thread per turn, four-sentence budget, max_tokens 220 as a mechanical backstop.", "_origin": "semantic"}, {"id": "docs_2026_08_17_short_turns_and_chunked_pause_resume_messages", "label": "ABORTED_RESUME_MESSAGE / UNHEARD_RESUME_MESSAGE", "file_type": "concept", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replace the unbounded SOFT_RESUME_MESSAGE so a resume restates at most one chunk.", "_origin": "semantic"}], "edges": [{"source": "docs_2026_08_17_short_turns_and_chunked_pause", "target": "docs_2026_08_16_tutor_pause_hold_the_line", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_17_short_turns_and_chunked_pause", "target": "docs_2026_08_17_short_turns_and_chunked_pause_pause_stop_message", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_17_short_turns_and_chunked_pause", "target": "docs_2026_08_17_short_turns_and_chunked_pause_next_chunk_tool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_17_short_turns_and_chunked_pause", "target": "docs_2026_08_17_short_turns_and_chunked_pause_words_1_4", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_17_short_turns_and_chunked_pause", "target": "docs_2026_08_17_short_turns_and_chunked_pause_resume_messages", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-17-short-turns-and-chunked
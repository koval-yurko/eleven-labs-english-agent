{"nodes": [{"id": "docs_2026_08_13_expo_s2_auth0_bearer", "label": "S2 \u2014 Auth0 on a device, Bearer on the server (B1)", "file_type": "document", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d14_callback_scheme", "label": "D14 \u2014 Auth0 callback scheme {bundleId}.auth0", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plugin default is already per-variant unique, keeps auth callbacks separate from app deep links, and matches Auth0's iOS quickstart.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d15_jose", "label": "D15 \u2014 jose as direct dependency", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "jose was only transitive; an Auth0 SDK upgrade dropping it would silently break mobile authentication.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d16_with_bearer", "label": "D16 \u2014 withBearer wrapper", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-route auth checks can be forgotten and fail open; the wrapper makes a handler impossible to write without ownerId.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d17_token_lifetime", "label": "D17 \u2014 lower API token lifetime to test renewal", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null,
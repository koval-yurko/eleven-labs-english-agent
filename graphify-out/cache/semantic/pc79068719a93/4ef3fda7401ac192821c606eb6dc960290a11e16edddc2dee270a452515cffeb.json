{"nodes": [{"id": "docs_2026_07_18_word_details_enrichment_job", "label": "The word-details enrichment job", "file_type": "document", "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second background job on the level job's machinery, copying its queue, flag, triggers and failure discipline.", "_origin": "semantic"}, {"id": "docs_2026_07_18_word_details_enrichment_job_word_details_payload", "label": "WordDetails payload (pos, translations_ru, forms, examples)", "file_type": "concept", "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored as jsonb on words because it is a nested 1:1 document with no query needs (categories precedent).", "_origin": "semantic"}, {"id": "docs_2026_07_18_word_details_enrichment_job_details_at_flag", "label": "details_at ATTEMPTED flag", "file_type": "concept", "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stamped on attempt, not success, so an un-enrichable word is asked once rather than every sweep; transport failures stamp nothing.", "_origin": "semantic"}, {"id": "docs_2026_07_18_word_details_enrichment_job_batch_size", "label": "Batch size 4 with maxTokens 8192", "file_type": "concept", "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each answer is ~300-500 tokens; batching 25 would truncate and silently lose items, so batch is small with per-item resilient parsing.", "_origin": "semantic"}, {"id": "docs_2026_07_18_word_details_enrichment_job_details_version", "label": "details_version column (targeted re-runs)", "file_type": "concept", "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets --force --stale re-run only rows from an older schema instead of re-billing the whole collection.", "_origin": "semantic"}, {"id": "docs_2026_07_18_word_details_enrichment_job_level_job", "label": "Level-assignment background job (machinery reused)", "file_type": "document", "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}], "edges": [{"source": "docs_2026_07_18_word_details_enrichment_job", "target": "docs_2026_07_18_word_details_enrichment_job_level_job", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_07_18_word_details_enrichment_job", "target": "docs_2026_07_18_word_details_enrichment_job_word_details_payload", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_07_18_word_details_enrichment_job", "target": "docs_2026_07_18_word_details_enrichment_job_details_at_flag", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-18-word-details-enrichment-job.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_07_18_word_details_enrichment_job", "target": "docs_2026_07_18_word_details_enrichment_job_batch_size", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-18-word-de
{"nodes": [{"id": "docs_2026_07_03_light_dark_theme_support", "label": "Light/dark theme support plan", "file_type": "document", "source_file": "docs/2026-07-03-light-dark-theme-support.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_theme_light_dark_toggle", "label": "Three-state (System/Light/Dark) theme toggle", "file_type": "concept", "source_file": "docs/2026-07-03-light-dark-theme-support.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-state with default System resolving to Dark honors 'dark is default' while still respecting users whose OS is set to light."}, {"id": "concept_theme_flash_fix", "label": "Pre-paint blocking script kills theme FOUC", "file_type": "concept", "source_file": "docs/2026-07-03-light-dark-theme-support.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A normal useEffect reads localStorage only after hydration, so the server-rendered dark markup paints first and then flashes to the stored theme; a synchronous inline script in <head> runs before first paint to stamp data-theme before anything renders."}], "edges": [{"source": "docs_2026_07_03_light_dark_theme_support", "target": "concept_theme_light_dark_toggle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-03-light-dark-theme-support.md", "source_location": null, "weight": 1}, {"source": "docs_2026_07_03_light_dark_theme_support", "target": "concept_theme_flash_fix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-03-light-dark-theme-support.md", "source_location": null, "weight": 1}], "hyperedges": []}
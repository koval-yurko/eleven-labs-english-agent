{"nodes": [{"id": "docs_2026_06_27_agent_prompt_version_switching", "label": "Agent prompt version switching design", "file_type": "document", "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_agent_versioning_native", "label": "ElevenLabs native agent versioning (evaluated, insufficient)", "file_type": "concept", "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native version routing is dashboard-driven or deterministic traffic-split by conversation-id hash \u2014 automatic A/B, not user-pickable \u2014 so it doesn't satisfy 'pick version X for this session' and app-level routing (Option A) was chosen instead."}, {"id": "concept_prompt_version_registry", "label": "Filesystem prompt-version registry (source of truth)", "file_type": "concept", "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The filesystem is made the source of truth so adding a version is adding a file and removing is deleting one; the version string is the identity key, so renaming reads as delete+create."}, {"id": "concept_agents_lock_json", "label": "agents.lock.json committed version\u2192agentId map", "file_type": "concept", "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Committed because agent ids are not secrets, so every clone/deploy shares the same ids and the runtime reads it directly instead of guessing or re-provisioning."}, {"id": "concept_sync_agents_script", "label": "pnpm sync:agents reconcile script", "file_type": "concept", "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the old non-idempotent create-agent.ts (which made a fresh agent every run) with an idempotent create/update-in-place/retire/delete reconcile keyed on a content hash of everything baked into the agent."}, {"id": "concept_agent_registry_lib", "label": "lib/agent-registry.ts runtime reader", "file_type": "concept", "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_2026_06_27_agent_prompt_version_switching", "target": "docs_2026_06_26_minimal_english_words_voice_agent", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.7, "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "weight": 0.6}, {"source": "docs_2026_06_27_agent_prompt_version_switching", "target": "concept_agent_versioning_native", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "weight": 1}, {"source": "docs_2026_06_27_agent_prompt_version_switching", "target": "concept_prompt_version_registry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "weight": 1}, {"source": "docs_2026_06_27_agent_prompt_version_switching", "target": "concept_agents_lock_json", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-06-27-agent-prompt-version-switching.md", "source_location": null, "weight": 1}, {"source": "docs_2026_06_27_agent_prompt_version_switching", "target": "concept_sync_agents_script", "relat
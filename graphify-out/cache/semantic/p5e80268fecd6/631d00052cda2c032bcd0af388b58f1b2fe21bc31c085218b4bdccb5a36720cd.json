{"nodes": [{"id": "docs_2026_08_22_word_popularity_replaces_favorites", "label": "Popularity replaces favourites design doc", "file_type": "document", "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_08_22_word_popularity_replaces_favorites_d1_popularity_column", "label": "D1: popularity int not null default 0 replaces is_favorite", "file_type": "concept", "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not-null default 0 avoids nullsFirst handling; backfilling existing words to 0 rather than mapping true\u21921 because a boolean cannot be honestly converted to a count."}, {"id": "docs_2026_08_22_word_popularity_replaces_favorites_d4_bump_rpc", "label": "D4: bump_word_popularity as an atomic RPC", "file_type": "concept", "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A read-modify-write cannot be expressed through PostgREST and would lose concurrent bumps; a SQL function keeps it atomic and returns the new value for the UI."}, {"id": "docs_2026_08_22_word_popularity_replaces_favorites_d6_suggest_words_word_id", "label": "D6: suggest_words returns word_id instead of owned boolean", "file_type": "concept", "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "owned was already (w.id is not null); returning w.id carries strictly more information at the same cost and is the only way the dropdown can navigate without client-side identity guessing."}, {"id": "docs_2026_08_22_word_popularity_replaces_favorites_d7_dropdown_navigates", "label": "D7: tapping an owned suggestion bumps and navigates", "file_type": "concept", "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deliberate exception to Autocomplete's 'never submit on tap' rule because an owned row's action is non-destructive and reversible (navigation plus a counter that only increases), unlike creating an unwanted word."}, {"id": "docs_2026_08_22_word_popularity_replaces_favorites_d9_remove_favorites_filter", "label": "D9: remove favoritesOnly filter entirely", "file_type": "concept", "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 'popular only' filter has no obvious threshold; sorting by popularity answers the same question better."}], "edges": [{"source": "docs_2026_08_22_word_popularity_replaces_favorites", "target": "docs_2026_08_22_word_popularity_replaces_favorites_d1_popularity_column", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_22_word_popularity_replaces_favorites", "target": "docs_2026_08_22_word_popularity_replaces_favorites_d4_bump_rpc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_22_word_popularity_replaces_favorites", "target": "docs_2026_08_22_word_popularity_replaces_favorites_d6_suggest_words_word_id", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_22_word_popularity_replaces_favorites", "target": "docs_2026_08_22_word_popularity_replaces_favorites_d7_dropdown_navigates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_22_word_popularity_replaces_favorites", "target": "docs_2026_08_22_word_popularity_replaces_favorites_d9_remove_favorites_filter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-08-22-word-popularity-replaces-favorites.md", "source_location": null, "weight": 0.9}], "hyperedges": []}
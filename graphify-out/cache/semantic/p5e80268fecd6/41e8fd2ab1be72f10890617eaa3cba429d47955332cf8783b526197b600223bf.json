{"nodes": [{"id": "docs_2026_09_11_voice_provider_pricing", "label": "Voice Provider Pricing", "file_type": "document", "source_file": "docs/2026-09-11-voice-provider-pricing.md"}, {"id": "docs_2026_09_11_voice_provider_pricing", "label": "Voice Provider Pricing", "file_type": "document", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": null, "source_url": null, "captured_at": "2026-09-11", "author": null, "contributor": null, "rationale": "The tutor talks ~90% of a lesson (850-920 tutor characters/min), which is what makes character- or token-billed voices (Vapi, OpenAI) cost more per minute than flat per-minute pricing (ElevenLabs); this single measured ratio drives most of the document's conclusions."}, {"id": "docs_2026_09_11_voice_provider_pricing_elevenlabs_agents", "label": "ElevenLabs Agents pricing model", "file_type": "concept", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_09_11_voice_provider_pricing_openai_realtime", "label": "OpenAI Realtime pricing model", "file_type": "concept", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_09_11_voice_provider_pricing_vapi", "label": "Vapi pricing model", "file_type": "concept", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A held pause is not cheap on Vapi because the $0.05/min platform fee and STT keep billing while the line is held, unlike ElevenLabs (5% silence rate) or OpenAI (no committed audio, no tokens billed)."}, {"id": "docs_2026_09_11_voice_provider_pricing_hume_evi", "label": "Hume EVI pricing option", "file_type": "concept", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_09_11_voice_provider_pricing_deepgram_voice_agent", "label": "Deepgram Voice Agent pricing option", "file_type": "concept", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_09_11_voice_provider_pricing_ultravox", "label": "Ultravox pricing option", "file_type": "concept", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_09_11_voice_provider_pricing_gemini_live", "label": "Gemini Live pricing option", "file_type": "concept", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deprioritized for testing because the price grows with session length, same re-send-full-context issue as OpenAI Realtime."}, {"id": "docs_2026_09_11_voice_provider_pricing_livekit_diy", "label": "DIY LiveKit Agents stack", "file_type": "concept", "source_file": "docs/2026-09-11-voice-provider-pricing.md", "source_location": "\u00a74, \u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once Claude is paid for directly, orchestration plus speech can be bought for ~$0.03-0.04/min; anything above that on managed platforms is margin or a pricier voice \u2014 worth building only once usage approaches the 100-learner column where platform margin is thousands/month."}], "edges": [{"source": "docs_2026_09_11_voice_provider_pricing", "target": "docs_2026_08_22_openai_realtime_second_provider", "relation": "cites
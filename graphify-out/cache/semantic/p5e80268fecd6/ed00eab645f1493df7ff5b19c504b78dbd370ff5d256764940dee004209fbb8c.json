{"nodes": [{"id": "docs_2026_08_27_mcp_static_token_auth", "label": "Static Bearer token replaces MCP OAuth doc", "file_type": "document", "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_08_27_mcp_static_token_auth_static_token_decision", "label": "Decision: adopt one static MCP_TOKEN secret, drop OAuth", "file_type": "concept", "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-user OAuth identity was being spent on exactly one learner at the price of Auth0 objects per client per environment; the one property worth keeping (a credential useless anywhere else) survives for free since a static token is not a JWT and /api/v2 rejects it at jwtVerify."}, {"id": "docs_2026_08_27_mcp_static_token_auth_anonymous_writes", "label": "MCP writes are anonymous; owner_id becomes nullable", "file_type": "concept", "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The static token authenticates a caller, not a person; an owner read from an env var would be a guess that is wrong silently forever with no signature to disagree with it, so unclaimed words are stored with owner_id NULL."}, {"id": "docs_2026_08_27_mcp_static_token_auth_null_traps", "label": "Three NULL traps in the anonymous-write schema", "file_type": "concept", "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL NULL is never equal to itself, so the unique key, the popularity bump's owner filter, and RLS's select-by-owner all silently break for unowned rows unless fixed with 'nulls not distinct' and 'is not distinct from'."}, {"id": "docs_2026_08_27_mcp_static_token_auth", "label": "MCP Static Token Auth (companion doc)", "file_type": "document", "source_file": "docs/2026-08-27-mcp-static-token-auth.md"}], "edges": [{"source": "docs_2026_08_27_mcp_static_token_auth", "target": "docs_2026_08_23_mcp_server_add_words", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_27_mcp_static_token_auth", "target": "docs_2026_08_27_mcp_static_token_auth_static_token_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_27_mcp_static_token_auth", "target": "docs_2026_08_27_mcp_static_token_auth_anonymous_writes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_27_mcp_static_token_auth_anonymous_writes", "target": "docs_2026_08_27_mcp_static_token_auth_null_traps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "weight": 0.9}, {"source": "docs_2026_08_27_mcp_static_token_auth_static_token_decision", "target": "docs_2026_08_23_mcp_server_add_words_option_a_new_api", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-08-27-mcp-static-token-auth.md", "source_location": null, "weight": 0.9}], "hyperedges": []}
{"nodes": [{"id": "docs_2026_08_12_expo_app_creation", "label": "Expo app creation (doc, not loaded)", "file_type": "document", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_08_12_expo_app_creation", "label": "Expo app creation (superseding doc)", "file_type": "document", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_08_12_expo_app_creation", "label": "Expo app \u2014 full native port (doc)", "file_type": "document", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": "2026-08-12", "author": null, "contributor": null, "rationale": "Native chosen because a browser tab cannot hold a voice session through a phone lock; decisions D1-D5 (offline deferred, iOS only, web app untouched, /api/v2 namespace) scope the port."}, {"id": "concept_conversation_id_hazard_b3", "label": "B3 \u2014 conversation_id WebRTC-derivation hazard", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WebRTC derives conversationId from the LiveKit room name with a fallback to room_<timestamp>, which can silently diverge from the id the post-call webhook reports; mitigated by taking the id from the token route response instead."}, {"id": "concept_background_audio_b2", "label": "B2 \u2014 background audio through a locked screen", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "react-native-webrtc#1467: iOS suspends the app after ~40s only when no audio track exists in either direction; the tutor session always publishes/receives a track, so it should hold \u2014 confirmed on hardware at S1 with no CallKit needed."}, {"id": "docs_2026_08_12_expo_app_creation", "label": "Expo app creation doc (parent)", "file_type": "document", "source_file": "docs/2026-08-12-expo-app-creation.md"}], "edges": [{"source": "docs_2026_08_12_expo_app_creation", "target": "docs_2026_08_12_expo_build_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_12_expo_app_creation", "target": "docs_2026_08_09_expo_repo_structure_migration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 0.9}, {"source": "docs_2026_08_12_expo_app_creation", "target": "docs_2026_08_09_shareable_core_refactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 0.85}, {"source": "docs_2026_08_12_expo_app_creation", "target": "docs_2026_08_07_expo_migration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 0.8}, {"source": "docs_2026_08_12_expo_app_creation", "target": "supabase_readme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a79 B1", "weight": 0.9}, {"source": "docs_2026_08_12_expo_app_creation", "target": "docs_2026_08_13_expo_s0_scaffold_testflight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.8, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a79 D3", "weight": 0.8}, {"source": "docs_2
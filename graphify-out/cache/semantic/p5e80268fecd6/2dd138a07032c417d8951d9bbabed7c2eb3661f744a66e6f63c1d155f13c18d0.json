{"nodes": [{"id": "docs_2026_08_27_vapi_doc", "label": "Vapi as a third voice provider", "file_type": "document", "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_08_27_vapi_doc_tutor_transport", "label": "TutorTransport seam", "file_type": "concept", "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_08_27_vapi_doc_path_a_daily_shim", "label": "Vapi path A: Daily SDK with LiveKit WebRTC alias and shim", "file_type": "concept", "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily's WebRTC fork collides with LiveKit's at pod install. Deleting Daily's fork and aliasing it to LiveKit's, plus shimming four fork-only native methods, works on device but is unsupported upstream."}, {"id": "docs_2026_08_27_vapi_doc_path_b_websocket", "label": "Vapi path B: WebSocket transport with native PCM module", "file_type": "concept", "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the prompt and word list server-side, needs no Daily or second WebRTC fork, but requires owning AEC and jitter handling in a native module."}, {"id": "docs_2026_08_27_vapi_doc_prompt_server_side", "label": "Prompt must not leave the server", "file_type": "concept", "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shipped binary could lie about client-supplied prompt content, so prefer an assistant id plus variableValues, or a server-created call, with allowTransientAssistant false."}, {"id": "docs_2026_08_27_vapi_doc_byok_decision", "label": "Decision against ElevenLabs BYOK on Vapi", "file_type": "concept", "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handing a third party the xi-api-key was not worth it once keeping the voice constant stopped being the goal; otherwise voice would be billed twice through Vapi's markup."}], "edges": [{"source": "docs_2026_08_27_vapi_doc", "target": "docs_2026_08_27_vapi_doc_tutor_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_27_vapi_doc", "target": "docs_2026_08_27_vapi_doc_path_a_daily_shim", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_27_vapi_doc", "target": "docs_2026_08_27_vapi_doc_path_b_websocket", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_27_vapi_doc", "target": "docs_2026_08_27_vapi_doc_prompt_server_side", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_27_vapi_doc", "target": "docs_2026_08_27_vapi_doc_byok_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-27-vapi-third-voice-provider.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_27_vapi_doc_path_a_daily_shim", "target": "docs
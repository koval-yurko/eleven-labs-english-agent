{"nodes": [{"id": "docs_2026_08_28_elevenlabs_mcp_in_code", "label": "ElevenLabs MCP attachment owned by the repo, doc", "file_type": "document", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_registration_per_toolset", "label": "A version's mcpTools set maps to one MCP server registration", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ElevenLabs' unit of grant is the server, not the tool (no per-agent allowed_tools), so narrowing a version's reach means registering a second server with a different tool set rather than listing fewer names."}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_approval_policy_hazard", "label": "approval_policy default hangs a lesson for 300s", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The platform default require_approval_all emits awaiting_approval and nothing answers it since the mobile transport has no MCP approval code, so the registration must pin auto_approve_all explicitly."}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code", "label": "ElevenLabs MCP In Code", "file_type": "document", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md"}, {"id": "concept_mcp_per_conversation_identity", "label": "Decision: per-conversation MCP identity deferred (\u00a710)", "file_type": "rationale", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "rationale": "Not built because it is a genuinely different capability that changes lib/mcp/auth.ts from a boolean check into identity resolution and changes owner_id semantics; its trigger is the second learner, not this build."}, {"id": "concept_webhook_tool_vs_mcp_server_tradeoff", "label": "Decision: MCP server over webhook tool (\u00a711)", "file_type": "rationale", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "rationale": "Inline prompt.tools is deprecated in favour of workspace tool_ids, so a webhook tool is also a remote object needing lockfile discipline; MCP wins because the schema is generated once from MAX_ITEMS/MAX_WORD_LENGTH and reused by OpenAI/Claude Code/Cursor instead of duplicated as a vendor JSON blob."}], "edges": [{"source": "docs_2026_08_28_elevenlabs_mcp_in_code", "target": "docs_2026_08_23_mcp_server_add_words", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": null, "weight": 0.95}, {"source": "docs_2026_08_28_elevenlabs_mcp_in_code", "target": "docs_2026_08_27_mcp_static_token_auth", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": null, "weight": 0.95}, {"source": "docs_2026_08_28_elevenlabs_mcp_in_code", "target": "docs_2026_08_28_elevenlabs_mcp_in_code_registration_per_toolset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_28_elevenlabs_mcp_in_code", "target": "docs_2026_08_28_elevenlabs_mcp_in_code_approval_policy_hazard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": null, "weight": 1}, {"source": "docs_2026_08_28_elevenlabs_mcp_in_code", "target": "concept_mcp_per_conversation_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "weight": 1}, {"source": "d
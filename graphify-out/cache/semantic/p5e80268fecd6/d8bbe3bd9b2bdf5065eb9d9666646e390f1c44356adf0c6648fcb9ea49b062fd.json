{"nodes": [{"id": "docs_2026_08_16_tutor_pause_hold_the_line", "label": "Pause by Holding the Line Open", "file_type": "document", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "rationale": "Reconnect-and-replay always repeats because the resumed conversation is a new one whose system prompt outranks a truncated chat-log context; holding the line open avoids ever needing a handoff."}, {"id": "concept_held_pause_state_machine", "label": "Held-pause state machine (live/muted/held/held-from-muted)", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "rationale": "held-from-muted exists as a one-bit memory (wasMuted) rather than a fifth behaviour, so Resume restores a deliberate prior mute instead of clobbering it."}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line", "label": "Tutor pause: hold the line (referenced)", "file_type": "document", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line", "label": "Tutor Pause: Hold The Line", "file_type": "document", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line", "label": "Tutor pause: hold the line", "file_type": "document", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": "2026-08-16", "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_2026_08_16_tutor_pause_hold_the_line", "target": "docs_2026_08_16_tutor_session_pause_resume", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "weight": 1}, {"source": "docs_2026_08_16_tutor_pause_hold_the_line", "target": "concept_held_pause_state_machine", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "wei
{"nodes": [{"id": "docs_2026_08_22_shared_package_structure", "label": "Shared package structure decision doc", "file_type": "document", "source_file": "docs/2026-08-22-shared-package-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_08_22_shared_package_structure_option_a_domain_folders", "label": "Option A: domain folders (approved)", "file_type": "concept", "source_file": "docs/2026-08-22-shared-package-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over B because 'where does the pause live' is the question people actually ask, and over D because paying a permanent package.json maintenance cost to prevent one import of a fake is the wrong trade at fourteen modules."}, {"id": "docs_2026_08_22_shared_package_structure_option_b_layer_folders", "label": "Option B: layer folders (rejected)", "file_type": "concept", "source_file": "docs/2026-08-22-shared-package-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected because it optimizes for dependency depth rather than subject; nobody asks 'what is in layer 2', and a file's layer changes for reasons unrelated to what it is about."}, {"id": "docs_2026_08_22_shared_package_structure_option_c_stay_flat", "label": "Option C: stay flat, document only (fallback, not taken)", "file_type": "concept", "source_file": "docs/2026-08-22-shared-package-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero churn but leaves prefixes doing a directory's job and the fake transport publicly importable; the growth rate (three of four new modules were tutor-* files) argued against betting on it."}, {"id": "docs_2026_08_22_shared_package_structure_option_d_domains_with_surface", "
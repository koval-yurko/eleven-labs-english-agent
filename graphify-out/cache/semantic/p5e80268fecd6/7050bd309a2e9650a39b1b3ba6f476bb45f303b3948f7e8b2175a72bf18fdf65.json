{"nodes": [{"id": "docs_2026_07_17_delete_lesson_keep_words", "label": "Delete a lesson \u2014 soft-delete it, keep the words (and their practice credit)", "file_type": "document", "source_file": "docs/2026-07-17-delete-lesson-keep-words.md", "source_location": null, "source_url": null, "captured_at": "2026-07-17", "author": null, "contributor": null, "rationale": "Soft delete (lessons.deleted_at) chosen over hard delete to preserve conversation history and each word's earned practice credit. owner_item_practice view is deliberately left unchanged on delete so a deleted lesson still credits its words, while owner_items is updated to treat the lesson as unattached \u2014 this split view behavior is the entire feature."}, {"id": "docs_2026_07_17_delete_lesson_keep_words", "label": "Delete lesson, keep words (referenced)", "file_type": "document", "source_file": "docs/2026-07-17-delete-lesson-keep-words.md"}], "edges": [{"source": "docs_2026_07_17_delete_lesson_keep_words", "target": "docs_2026_07_16_add_word_on_lesson_items_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-17-delete-lesson-keep-words.md", "source_location": null, "weight": 1}, {"source": "docs_2026_07_17_delete_lesson_keep_words", "target": "docs_2026_07_04_offline_support_and_sync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-17-delete-lesson-keep-words.md", "source_location": null, "weight": 1}, {"source": "docs_2026_07_17_delete_lesson_keep_words", "target": "docs_2026_07_16_level_assignment_background_job", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-07-17-delete-lesson-keep-words.md", "source_location": null, "weight": 1}], "hyperedges": []}
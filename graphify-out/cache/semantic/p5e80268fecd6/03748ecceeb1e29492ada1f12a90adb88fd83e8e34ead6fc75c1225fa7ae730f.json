{"nodes": [{"id": "docs_2026_06_28_langsmith_tracing_observability", "label": "LangSmith tracing via post-call webhook bridge", "file_type": "document", "source_file": "docs/2026-06-28-langsmith-tracing-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tutor's LLM runs inside ElevenLabs convai, not in this app's LangChain code, so LangSmith sees nothing natively; the post-call webhook is the one authoritative, server-side, tool-call-inclusive record available to bridge into a trace."}, {"id": "concept_langsmith_runtree_bridge", "label": "Approach B1: webhook payload \u2192 LangSmith RunTree", "file_type": "concept", "source_file": "docs/2026-06-28-langsmith-tracing-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over OpenTelemetry (B2) because ElevenLabs' OTLP span attributes may not match OpenLLMetry/GenAI semantic conventions, so manual RunTree mapping guarantees the intended llm/tool waterfall shape."}, {"id": "concept_elevenlabs_post_call_webhook", "label": "ElevenLabs post_call_transcription webhook payload", "file_type": "concept", "source_file": "docs/2026-06-28-langsmith-tracing-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers transcript, tool_calls/tool_results, per-turn llm_usage, dynamic variables and analysis \u2014 everything needed except the agent's hidden chain-of-thought, which no vendor exposes."}, {"id": "concept_elevenlabs_webhook_route", "label": "src/app/api/words-agent/elevenlabs-webhook route", "file_type": "concept", "source_file": "docs/2026-06-28-langsmith-tracing-observability.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be public (no Auth0 middleware) since webhooks are unauthenticat
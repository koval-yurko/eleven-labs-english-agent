{"nodes": [{"id": "docs_2026_10_02_livekit_silent_tts_on_spent_quota", "label": "LiveKit: spent ElevenLabs quota is a tutor with no voice", "file_type": "document", "source_file": "docs/2026-10-02-livekit-silent-tts-on-spent-quota.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Incident debug report d2a257ee: ElevenLabs quota exhausted made the streaming socket return empty audio with no error, so every worker signal stayed quiet."}, {"id": "docs_2026_10_02_silent_reply_detection", "label": "Silent-reply detection and tutor.failed signal", "file_type": "concept", "source_file": "docs/2026-10-02-livekit-silent-tts-on-spent-quota.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a quota check, the lesson ends on the second consecutive silent reply with a generic sentence; unknown-method rejection on old builds shows a card without the sentence."}, {"id": "docs_2026_10_02_deepgram_aura2_tts", "label": "Deepgram Aura-2 TTS switch", "file_type": "concept", "source_file": "docs/2026-10-02-livekit-silent-tts-on-spent-quota.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aura-2 is cheaper (~$0.03 vs $0.05 per 1k chars) and removes ElevenLabs quota as a failure mode; English-only voices. Flux TTS rejected: Early Access, pricier ($0.045), needs a custom plugin, Russian garbage."}, {"id": "docs_2026_10_02_elevenlabs_credits", "label": "elevenlabs-credits shared decision", "file_type": "concept", "source_file": "docs/2026-10-02-livekit-silent-tts-on-spent-quota.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_2026_10_02_livekit_token_route", "label": "words-agent/livekit-token route", "file_type": "concept", "source_file": "docs/2026-10-02-livekit-silent-tts-on-sp
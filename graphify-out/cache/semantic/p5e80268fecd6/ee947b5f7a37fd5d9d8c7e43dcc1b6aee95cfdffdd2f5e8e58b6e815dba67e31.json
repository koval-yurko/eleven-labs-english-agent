{"nodes": [{"id": "docs_2026_09_11_livekit_claude_diy_provider", "label": "LiveKit + Claude DIY Provider Research", "file_type": "document", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md"}, {"id": "apps_voice_worker", "label": "apps/voice-worker/ (proposed LiveKit worker)", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "rationale": "Not built; sized as a proposed new workspace app for a LiveKit+Claude DIY voice pipeline."}, {"id": "packages_shared_src_tutor_livekit_wire", "label": "packages/shared/src/tutor/livekit-wire.ts (proposed)", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md"}, {"id": "apps_web_src_app_api_v2_words_agent_livekit_token_route", "label": "POST /api/v2/words-agent/livekit-token (proposed)", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md"}, {"id": "apps_web_src_app_api_v2_livekit_session_end_route", "label": "POST /api/v2/livekit/session-end (proposed)", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md"}, {"id": "apps_mobile_src_lib_transport_livekit", "label": "transport/livekit.ts (proposed)", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md"}, {"id": "agent_prompts_words_4_0", "label": "agent/prompts/words-4.0.ts (proposed, provider livekit)", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md"}, {"id": "concept_livekit_claude_own_adapter", "label": "Recommendation: write our own ~300-line Claude LLM adapter", "file_type": "rationale", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "rationale": "Both LiveKit Anthropic plugins trail the Claude API: the Node plugin has no prompt caching and hoists system/developer messages to the top (invalidating the cache on every pause), and the Python plugin hard-codes a prefill guard that 400s on Sonnet 5/Opus 4.7+."}, {"id": "concept_turn_ledger", "label": "Turn ledger: per-turn latency/token/cache record", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "rationale": "Cascaded pipeline gives exact per-turn tokens, cache hits and TTFT, unlike the summed usage figure the non-ElevenLabs providers get today."}, {"id": "concept_one_id_everywhere", "label": "One conversationId names room, DB row, trace, and report", "file_type": "rationale", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "rationale": "Extending conversationId to be the room name, dispatch metadata, OTel resource attribute and worker log field lets one 8-char id prefix find every system's timeline for a bad lesson."}, {"id": "docs_2026_09_11_livekit_claude_diy_provider", "label": "LiveKit + Claude DIY provider (stub)", "file_type": "document", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "source_location": null, "source_url": null, "captured_at": "2026-09-11", "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_2026_09_11_livekit_claude_diy_provider", "target": "apps_voice_worker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "weight": 1}, {"source": "docs_2026_09_11_livekit_claude_diy_provider", "target": "packages_shared_src_tutor_livekit_wire", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "weight": 1}, {"source": "docs_2026_09_11_livekit_claude_diy_provider", "target": "apps_web_src_app_api_v2_words_agent_livekit_token_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "weight": 1}, {"source": "docs_2026_09_11_livekit_claude_diy_provider", "target": "apps_web_src_app_api_v2_livekit_session_end_route", "relation": "references", "confidenc
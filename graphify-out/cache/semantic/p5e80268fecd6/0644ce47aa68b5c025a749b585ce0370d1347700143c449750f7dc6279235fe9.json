{"nodes": [{"id": "claude", "label": "CLAUDE.md (root)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_mobile_is_product", "label": "Mobile app is the only active product", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iOS revokes the microphone and drops the socket the moment Safari leaves the foreground, so a browser voice lesson cannot survive a locked screen."}, {"id": "concept_web_backend_deprecated", "label": "apps/web is deprecated as UI, kept as backend", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_ops_surfaces", "label": "apps/web/src/app/ops operator surfaces", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ops pages belong to the backend, not the deprecated client, because they inspect data the backend owns; nothing under /ops is linked from learner navigation."}, {"id": "concept_packages_shared_pure_core", "label": "packages/shared pure core (zero deps)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test for adding something here: if a bug in it could be fixed by deploying the web app alone, it belongs on the server instead \u2014 only cross-client agreements belong."}, {"id": "concept_resolve_words_rpc", "label": "resolve_words RPC as sole word-identity path", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Word identity (norm_key) needs Postgres unaccent+NFKC, so client-side normalization is deliberately weaker than the server's \u2014 merging less just leaves a dup for the server to skip, merging more could silently drop a word."}, {"id": "concept_words_level_details_jobs", "label": "words.level / words.details background jobs", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The *_at columns are ATTEMPTED flags stamped whether or not the model answered, so an un-answerable word is asked about once rather than every sweep, and the nullable columns need no scheduler."}, {"id": "concept_tutor_prompts_registry", "label": "Tutor prompts versioned source registry", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_llm_langchain_access", "label": "LLM access goes through LangChain (ChatAnthropic)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_sanitize_transcript", "label": "sanitizeTranscript single sanitization point", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The action, beacon route, and both post-call webhooks all upsert the same conversation_id row through one function so the stored row doesn't depend on which writer landed last."}, {"id": "concept_offline_mirror_outbox", "label": "Offline mirror + outbox in one transaction", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mirror write and its queued op go in the same transact, which is why the UI can never show a change whose intent wasn't queued."}, {"id": "concept_graphify_code_map", "label": "graphify code map (tree-sitter + LLM semantic pass)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "claude_md", "label": "CLAUDE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "claude", "target": "concept_mobile_is_product", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CLAUDE.md", "source_location": null, "weight": 1}, {"source": "claude", "target": "concept_web_backend_deprecated", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CLAUDE.md", "source_location": null, "weight": 1}, {"source": "claude", "target": "concept_ops_surfaces", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CLAUDE.md", "source_location": null, "weight": 1}, {"source": "claude", "target": "concept_packages_shared_pure_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CLAUDE.md", "source_location": null, "weight": 1}, {"source": "claude", "target": "concept_resolve_words_rpc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CLAUDE.md", "source_location": null, "weight": 1}, {"source": "claude", "target": "concept_words_level_details_jobs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CLAUDE.md", "source_location": null, "weight": 1}, {"source": "claude", "target": "concept_tutor_prompts_registry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CL
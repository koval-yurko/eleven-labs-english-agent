{"nodes": [{"id": "docs_2026_10_30_prompt_version_customization", "label": "Prompt version customization (declarative options per version)", "file_type": "document", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One generic UI renders every version's options; a version only declares options as data, so a new version needs no UI change.", "_origin": "semantic"}, {"id": "packages_shared_src_tutor_customization", "label": "customization.ts (CustomizationSchema, resolveCustomization)", "file_type": "code", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lives in packages/shared because API, phone and worker must agree on it; no JSON Schema or zod so shared stays dependency-free.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_2026_10_30_prompt_version_customization_resolvecustomization", "label": "resolveCustomization", "file_type": "code", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure validator run by both API and phone: drops unknown keys, falls back to default on wrong type or out-of-range, snaps numbers to step. Stale saved values never fail.", "_origin": "semantic"}, {"id": "docs_2026_10_30_prompt_version_customization_customizationtarget", "label": "CustomizationTarget", "file_type": "concept", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": "\u00a74, \u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opened after review: stage closed (stt|tts), key open, so new provider options need no shared-code change and the worker owns its registry. Cost: key typos are not compile errors.", "_origin": "semantic"}, {"id": "docs_2026_10_30_prompt_version_customization_customizationfield", "label": "CustomizationField (select/number/boolean)", "file_type": "concept", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tagged union lets the compiler check every version module.", "_origin": "semantic"}, {"id": "docs_2026_10_30_prompt_version_customization_words_4_5", "label": "words-4.5 prompt version", "file_type": "concept", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": "\u00a71.3, \u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_10_30_prompt_version_customization_tutoroptionsmodal", "label": "TutorOptionsModal (tutor-options-modal.tsx)", "file_type": "code", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": "\u00a76, \u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Form mounts on each open so the draft starts from saved values; Reset changes draft only.", "_origin": "semantic"}, {"id": "docs_2026_10_30_prompt_version_customization_agentversionsummary", "label": "AgentVersionSummary DTO", "file_type": "code", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": "\u00a71.1, \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_10_30_prompt_version_customization_livekitdispatchmetadata", "label": "LiveKitDispatchMetadata", "file_type": "code", "source_file": "docs/2026-10-30-prompt-version-customization.md", "source_location": "\u00a71.2, \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor"
{"nodes": [{"id": "docs_2026_08_15_word_autocomplete_suggestions", "label": "Word autocomplete on the add-word input", "file_type": "document", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CEFR lists miss words learners add (e.g. ubiquitous), so a larger lexicon is built with level as annotation.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_lexicon_table", "label": "lexicon Postgres table (D1, D3)", "file_type": "code", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server table not bundled asset: no expo-updates so a bundled lexicon would gate fixes behind App Store releases; not owner-scoped shared reference data.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_build_lexicon", "label": "build_lexicon.py and load-lexicon.ts", "file_type": "code", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Joins WikDict, CEFR-J/Octanove and wordfreq at build time; loader stages and dedupes in SQL, runs ANALYZE.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_level_job", "label": "Lexicon level batch job (D2)", "file_type": "code", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opus 5 chosen over Haiku 4.5 after eval (50%/93% vs 39%/89%); bypasses LangChain because it lacks Message Batches binding.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_suggest_route", "label": "GET /api/v2/lexicon/suggest and suggest_words RPC", "file_type": "code", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefix sent raw and normalized only in Postgres so one lesson_item_norm_key implementation drives the owned join.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_autocomplete_component", "label": "Autocomplete component", "file_type": "code", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selection fills the input and never submits (D4) so mis-taps stay recoverable and the write path is unchanged.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_bucket_cache", "label": "Two-character bucket prefix cache", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local top-N slices matched server top-8 only 39.7-74.7% of the time; fetching the full 2-char bucket gives 100% with 88% fewer requests.", "_origin": "semantic"}, {"id": "docs_2026_08_15_word_autocomplete_suggestions_lexicon_levels", "label": "LexiconLevel (A1\u2013C2) vs CefrLevel", "file_type": "concept", "source_file": "docs/2026-08-15-word-autocomplete-suggestions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two vocabularies for two questions; widening CEFR_LEVELS would widen the items-query URL grammar for a level nothing can be filtered to.", "_origin": "semantic"}], "edges": [{"source": "docs_2026_08_15_word_autocomplete_suggestions", "target": "docs_2026_08_15_word_autocomplete_suggestions_lexicon_table", "relation": "conceptually_related_to", "confidence": "EXTRACTED",
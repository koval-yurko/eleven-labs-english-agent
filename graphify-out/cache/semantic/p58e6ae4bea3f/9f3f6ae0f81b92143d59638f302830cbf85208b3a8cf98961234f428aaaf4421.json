{"nodes": [{"id": "docs_2026_08_28_elevenlabs_mcp_in_code", "label": "MCP on ElevenLabs owned by the repo", "file_type": "document", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Corrects the premise that ElevenLabs MCP is dashboard-only; sync:agents can reconcile MCP server registrations with full REST CRUD.", "_origin": "semantic"}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_registration_per_toolset", "label": "One registration per distinct tool set", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ElevenLabs grants at server granularity, not per tool, so a version's mcpTools names a registration; keying by tool set means a new tool costs a new registration rather than a silent retroactive grant.", "_origin": "semantic"}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_approval_policy", "label": "approval_policy auto_approve_all pin", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default require_approval_all would hang a lesson 300 s because the mobile transport never answers mcp_tool_approval_result.", "_origin": "semantic"}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_secret_by_name", "label": "Credential via pre-existing workspace secret MCP_AUTHORIZATION_HEADER", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sent in request_headers.Authorization rather than secret_token because secret_token's Bearer-prefix behavior is undocumented; sync only resolves the id by exact name and never writes secrets.", "_origin": "semantic"}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_constant_url", "label": "MCP URL as constant with --allow-dev-mcp-url guard", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": "\u00a78.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ElevenLabs workspace is shared with production, so an env-read tunnel URL would repoint live agents.", "_origin": "semantic"}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_create_only_fields", "label": "Create-only MCP fields force replace", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": "\u00a715.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PATCH on mcp-servers does not accept url, name, description or transport, so changing them requires create+delete and re-patching agents.", "_origin": "semantic"}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_words_1_1", "label": "words-1.1 prompt version", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": "\u00a77.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Granting the tool on words-1.0 would spend the byte-identical prompt comparison across providers, so a new version composes the shared prompt plus clause plus grant.", "_origin": "semantic"}, {"id": "docs_2026_08_28_elevenlabs_mcp_in_code_per_conversation_credential", "label": "Per-conversation credential (deferred)", "file_type": "concept", "source_file": "docs/2026-08-28-elevenlabs-mcp-in-code.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MCP writes stay anonymous (owner_id NULL) until a second learner exists.", "_origin": "semantic"}, {"id": "sync_agents_ts", "label": "sync-agent
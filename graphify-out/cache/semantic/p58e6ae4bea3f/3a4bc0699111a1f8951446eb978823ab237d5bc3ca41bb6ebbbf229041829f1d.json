{"nodes": [{"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider", "label": "Vapi MCP on the third provider", "file_type": "document", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vapi accepts an inline MCP tool in model.tools, making it the cheapest of three providers to grant; token held in the assistant because Vapi has no secret store.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_vapi_mcp_tool", "label": "Vapi CreateMcpToolDTO inline tool", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inline model.tools avoids a second remote object, extra lockfile entry and delete-ordering constraint that a stored tool + toolIds would add.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_mcp_token_in_assistant", "label": "MCP_TOKEN written into Vapi assistant headers", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vapi's public API has no credential endpoints, so credentialId is an undocumented upgrade path; token is readable in clear via GET /assistant.", "_origin": "semantic"}, {"id": "docs_2026_09_10_vapi_mcp_on_the_third_provider_buildplan_mcpserverids_bug", "label": "buildPlan mcpServerIds applied to every driver bug", "file_type": "concept", "source_file": "docs/2026-09-10-vapi-mcp-on-the-third-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mcpServerIds is ElevenLabs-only; applying it to Vapi would cause an endless PATCH loop once words-3.1 granted tools.", "_orig
{"nodes": [{"id": "docs_2026_08_12_expo_app_creation", "label": "Expo app \u2014 full native port (creation doc)", "file_type": "document", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A browser tab cannot hold a voice session when the phone locks: iOS revokes the mic and drops the socket when Safari backgrounds. Everything follows from that.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_v2_api", "label": "/api/v2/* endpoint surface", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Namespace keeps Bearer-token path from ever running for the web app, so 'keep the web app as is' is enforced structurally (D4).", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_token_route", "label": "POST /api/v2/words-agent/token (WebRTC conversation token)", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Native SDK throws on signedUrl/websocket; the app must use conversationToken + webrtc. Agent id is resolved server-side so sync:agents can retire versions without breaking installed binaries.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_sync_flush", "label": "POST /api/v2/sync/flush (single-op batches)", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept even though v1 is online-only so adding offline later is a purely client-side change.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_b1_auth0", "label": "B1 \u2014 Auth0 Bearer on device", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate AUTH0_API_AUDIENCE verification-only variable so web login stays byte-for-byte unchanged.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_b2_background_audio", "label": "B2 \u2014 background audio through screen lock", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UIBackgroundModes audio plus an existing mic track keeps iOS from suspending (react-native-webrtc#1467); track existence, not content, holds the app.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_b3_conversation_id", "label": "B3 \u2014 WebRTC conversation_id hazard", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WebRTC derives conversationId from the room name with fallback room_<timestamp>, which may never match the webhook id; mitigated by taking the id from the token response.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_offline_mirror", "label": "Offline mirror (deferred, D1)", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes ~1 week from the critical path and drops the novel SQLite change-notification problem from the first release.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_expo_ui", "label": "D3 \u2014 Expo UI component strategy", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "ca
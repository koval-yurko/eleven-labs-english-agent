{"nodes": [{"id": "docs_2026_09_09_mobile_debug_reports_and_feedback", "label": "Debug reports from the phone", "file_type": "document", "source_file": "docs/2026-09-09-mobile-debug-reports-and-feedback.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces screenshot-of-one-sentence reporting with a diagnostics bus, snapshot, modal, table, operator page and pnpm report handoff.", "_origin": "semantic"}, {"id": "docs_2026_09_09_mobile_debug_reports_and_feedback_diagnostics_bus", "label": "Diagnostics bus (module singleton ring)", "file_type": "concept", "source_file": "docs/2026-09-09-mobile-debug-reports-and-feedback.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module scope because the session outlives screens, must not re-render, and must be writable from non-React code.", "_origin": "semantic"}, {"id": "docs_2026_09_09_mobile_debug_reports_and_feedback_snapshot", "label": "State snapshot including invisible refs", "file_type": "concept", "source_file": "docs/2026-09-09-mobile-debug-reports-and-feedback.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bugs live in refs the callbacks read; a registered function avoids re-render cost, and an at-error freeze preserves state that later drifts.", "_origin": "semantic"}, {"id": "docs_2026_09_09_mobile_debug_reports_and_feedback_sanitize", "label": "sanitizeDebugReport shared contract", "file_type": "concept", "source_file": "docs/2026-09-09-mobile-debug-reports-and-feedback.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on server and phone, truncates rather than rejects, preserves unknown codes so old builds can still file.", "_origin": "semantic"}, {"id": "docs_2026_09_09_mobile_debug_reports_and_fee
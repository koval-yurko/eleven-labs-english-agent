{"nodes": [{"id": "docs_2026_08_12_expo_app_creation", "label": "Expo app \u2014 full native port (creation doc)", "file_type": "document", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A browser tab cannot hold a voice session when the phone locks; iOS revokes the mic and drops the socket when Safari backgrounds, so a native app is required.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_api_v2", "label": "/api/v2/* endpoint surface", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate v2 namespace means the Bearer-token code path never runs for the web app, so keeping the web app unchanged is enforced structurally.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_webrtc_token", "label": "WebRTC conversation token route", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Native throws on signedUrl/websocket connections (needs AudioContext), so a v2 route calling /v1/convai/conversation/token returning {token, conversation_id} is needed; agentId is not sent from the app so sync:agents can retire versions.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_b1_auth0", "label": "B1 \u2014 Auth0 on device", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a79 B1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a verification-only AUTH0_API_AUDIENCE rather than AUTH0_AUDIENCE so web login stays byte-for-byte unchanged.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_b2_background_audio", "label": "B2 \u2014 background audio through screen lock", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a79 B2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UIBackgroundModes audio plus a persistent mic track (react-native-webrtc#1467) keeps iOS from suspending the app.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_b3_conversation_id", "label": "B3 \u2014 WebRTC conversation_id parity", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a79 B3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WebRTC derives conversationId from the room name with fallback to room_<timestamp>, which could fork lesson_sessions rows; mitigated by taking the id from the token response.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_offline_mirror", "label": "Offline mirror (deferred, D1)", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred from v1 to cut ~1 week from the critical path; /api/v2/sync/flush kept so offline later is a client-only change.", "_origin": "semantic"}, {"id": "docs_2026_08_12_expo_app_creation_sync_flush", "label": "POST /api/v2/sync/flush (single-op batches)", "file_type": "concept", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept despite online-only v1 so adding offline later is purely client-side; four bespoke REST mutations would have to be thrown away.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer", "label": "S2 \u2014 Auth0 + Bearer research note", "file_type": "document", "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}], "edges": [{"source": "docs_2026_08_12_expo_app_creation", "target": "docs_2026_08_12_expo_build_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_12_expo_app_creation_api_v2", "target": "docs_2026_08_12_expo_app_creation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_12_expo_app_creation_webrtc_token", "target": "docs_2026_08_12_expo_app_creation_api_v2", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_12_expo_app_creation_sync_flush", "target": "docs_2026_08_12_expo_app_creation_api_v2", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_12_expo_app_creation_sync_flush", "target": "docs_2026_08_12_expo_app_creation_offline_mirror", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-12-expo-app-creation.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_08_12_expo_app_creation_b3_conversation_id", "target": "docs_2026_08_12_expo_app_creation_webrtc_token", "relation": "conceptually_related_to", "confidence": "E
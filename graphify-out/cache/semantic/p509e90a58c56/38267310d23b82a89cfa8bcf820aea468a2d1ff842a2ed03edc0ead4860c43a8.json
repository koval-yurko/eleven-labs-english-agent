{"nodes": [{"id": "docs_2026_08_13_expo_s2_auth0_bearer", "label": "S2 \u2014 Auth0 on a device, Bearer on the server (B1)", "file_type": "document", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d14", "label": "D14 \u2014 Auth0 callback scheme {bundleId}.auth0", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plugin default is already per-variant unique, keeps auth callbacks separate from app deep links, and matches Auth0's iOS quickstart.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d15", "label": "D15 \u2014 jose as direct dependency", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifying tokens with a transitively-present package is fragile; an Auth0 SDK upgrade could drop it and break auth silently.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d16", "label": "D16 \u2014 withBearer wrapper", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A per-route check can be forgotten and fails open; the wrapper makes 'forgot to authenticate' inexpressible.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d17", "label": "D17 \u2014 lower API token lifetime to test renewal", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 24h lifetime makes the renewal gate untestable.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d18", "label": "D18 \u2014 minimal logout at S2", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without logout the login gate can run only once per install.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d19", "label": "D19 \u2014 useDPoP false", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "react-native-auth0 v5 defaults DPoP on, which would 401 against a server verifying plain Bearer JWTs.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s2_auth0_bearer_d20", "label": "D20 \u2014 no identifiers committed; env-sourced values", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hygiene against casual disclosure, not a security boundary; values are public once shipped.", "_origin": "semantic"}, {"id": "apps_web_src_lib_auth_bearer", "label": "apps/web/src/lib/auth/bearer.ts (getBearerOwnerId, withBearer)", "file_type": "code", "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}], "edges": [{"source": "docs_2026_08_13_expo_s2_auth0_bearer", "target": "docs_2026_08_13_expo_s2_auth0_bearer_d14", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-08-13-expo-s2-auth0-bearer.md", "source_location": null, "weight":
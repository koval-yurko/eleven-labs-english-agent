{"nodes": [{"id": "docs_2026_08_13_expo_s1_background_audio", "label": "S1 \u2014 background audio through a screen lock (B2)", "file_type": "document", "source_file": "docs/2026-08-13-expo-s1-background-audio.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s1_background_audio_d10_dependency_pins", "label": "D10 \u2014 LiveKit dependency pin set", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s1-background-audio.md", "source_location": "\u00a72 D10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@elevenlabs/client hard-depends on livekit-client 2.16.1 exactly; LiveKit RN 2.9.8 satisfies it while 2.12.0 would create two copies (two Room classes) in one process.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s1_background_audio_d12_preview_only", "label": "D12 \u2014 measure on preview builds only", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s1-background-audio.md", "source_location": "\u00a72 D12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dev clients drop Metro on backgrounding and attached debuggers prevent iOS suspension, producing false results.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s1_background_audio_d13_new_arch", "label": "D13 \u2014 New Architecture fallback removed", "file_type": "concept", "source_file": "docs/2026-08-13-expo-s1-background-audio.md", "source_location": "\u00a72 D13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "newArchEnabled:false was removed in RN 0.82 / SDK 55, so no architecture escape hatch exists.", "_origin": "semantic"}, {"id": "docs_2026_08_13_expo_s1_background_audio_audio_mechanism", "label": "registerGlobals audio session mechanism (2.9.8 vs 2.12.0)", "file_type": "concept", "source_file": "docs/2026-
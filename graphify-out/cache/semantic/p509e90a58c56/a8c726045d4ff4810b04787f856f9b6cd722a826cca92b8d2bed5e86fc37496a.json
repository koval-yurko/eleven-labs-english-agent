{"nodes": [{"id": "docs_2026_08_17_short_turns_and_chunked_pause", "label": "Short turns and a chunked pause", "file_type": "document", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pause can't be finer than one agent turn because the client cannot abort a turn; fix is smaller turns, a barge-in stop token, and bounded resume.", "_origin": "semantic"}, {"id": "docs_2026_08_17_short_turns_and_chunked_pause_pause_stop_message", "label": "PAUSE_STOP_MESSAGE (L5 barge-in)", "file_type": "concept", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "user_message triggers the same flow as spoken input, so it aborts an in-flight turn.", "_origin": "semantic"}, {"id": "docs_2026_08_17_short_turns_and_chunked_pause_next_chunk_tool", "label": "next_chunk client tool (L4)", "file_type": "concept", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes pause a boundary the conversation asks about and gives the app real lesson state; costs a second reconciled resource type in sync-agents.", "_origin": "semantic"}, {"id": "docs_2026_08_17_short_turns_and_chunked_pause_max_tokens", "label": "max_tokens backstop (L2)", "file_type": "concept", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "words_1_4_prompt", "label": "words-1.4 prompt version", "file_type": "concept", "source_file": "docs/2026-08-17-short-turns-and-chunked-pause.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "
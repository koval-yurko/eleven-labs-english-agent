{"nodes": [{"id": "docs_2026_08_16_tutor_pause_hold_the_line", "label": "Pause by holding the line open", "file_type": "document", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconnecting can never resume exactly, holding the line can never fail to: a resumed conversation is a new one whose system prompt fights a truncated chat log.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line_heartbeat", "label": "Mute + user_activity heartbeat", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "turn_timeout defaults to 7s and user_activity resets it, so a 3s ping keeps the agent quiet; contextual_update on a timer would not reset the timer and would accrete context.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line_setvolume_noop", "label": "setVolume is a no-op on React Native", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ElevenLabs SDK registers the audio adapter only in the web entrypoint, so silencing must go through LiveKit remote tracks via agent-audio.ts.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_hold_the_line_lesson_state", "label": "{{lesson_state}} dynamic variable (words-1.4 plan)", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-pause-hold-the-line.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lands in the system prompt at the same strength as the instruction it overrides, unlike a contextual update.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_pause_ho
{"nodes": [{"id": "docs_2026_10_03_remote_triggers_for_local_ios_build", "label": "Remote triggers for local iOS build (doc)", "file_type": "document", "source_file": "docs/2026-10-03-remote-triggers-for-local-ios-build.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision: make the Mac a GitHub Actions self-hosted runner so GitHub is the only thing that tells the Mac to build and no inbound connection is accepted; a tunnel+receiver was rejected as it needs three signature schemes, a queue, and a public attack surface.", "_origin": "semantic"}, {"id": "docs_2026_10_03_remote_triggers_for_local_ios_build_self_hosted_runner", "label": "GitHub self-hosted runner (actions-runner/)", "file_type": "concept", "source_file": "docs/2026-10-03-remote-triggers-for-local-ios-build.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outbound long-poll only; no tunnel, no open port; lives in one repo folder.", "_origin": "semantic"}, {"id": "docs_2026_10_03_remote_triggers_for_local_ios_build_ship_preview_workflow", "label": "ship-preview.yml workflow", "file_type": "code", "source_file": "docs/2026-10-03-remote-triggers-for-local-ios-build.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggers only on push to master, workflow_dispatch, repository_dispatch; concurrency cancel-in-progress false so a running xcodebuild is never discarded.", "_origin": "semantic"}, {"id": "docs_2026_10_03_remote_triggers_for_local_ios_build_job_started_hook", "label": "hooks/job-started.sh public-repo guard", "file_type": "code", "source_file": "docs/2026-10-03-remote-triggers-for-local-ios-build.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hook path comes from the runner's .env pointing at the working copy, so a PR cannot modify the guard; unset variables fail closed.", "_origin": "semantic"}, {"id": "docs_2026_10_03_remote_triggers_for_local_ios_build_runner_sh", "label": "runner.sh", "file_type": "code", "source_file": "docs/2026-10-03-remote-triggers-for-local-ios-build.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_2026_10_03_remote_triggers_for_local_ios_build_slack_relay", "label": "Slack Socket Mode relay (phase 2)", "file_type": "concept", "source_file": "docs/2026-10-03-remote-triggers-for-local-ios-build.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slack cannot hold a GitHub token; Socket Mode needs no Request URL or tunnel.", "_origin": "semantic"}, {"id": "docs_2026_10_03_remote_triggers_for_local_ios_build_three_layer_security", "label": "Three-layer security model for public repo runner", "file_type": "concept", "source_file": "docs/2026-10-03-remote-triggers-for-local-ios-build.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Personal repos cannot restrict runners via runner groups, so protection is approval gate, no-PR-trigger workflow, and on-Mac hook.", "_origin": "semantic"}], "edges": [{"source": "docs_2026_10_03_remote_triggers_for_local_ios_build", "target": "docs_2026_10_03_remote_triggers_for_local_ios_build_self_hosted_runner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/2026-10-03-remote-triggers-for-local-ios-build.md", "source_location": null, "weight": 1, "_origin": "semantic"}, {"source": "docs_2026_10_03_remote_triggers_for_local_ios_build_self_hosted_runner", "target": "docs_2026_10_03_remote_triggers_for_local_ios_build_ship_preview_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, 
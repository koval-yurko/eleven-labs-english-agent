{"nodes": [{"id": "docs_2026_08_16_tutor_session_pause_resume", "label": "Pause / resume \u2014 the parked path", "file_type": "document", "source_file": "docs/2026-08-16-tutor-session-pause-resume.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parked pause is demoted to the involuntary floor: dropped connection, 30-minute cap, crash, or leaving the screen; no platform API can resume a conversation, so every resume is a new conversation_id row.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_session_pause_resume_pause_marker", "label": "Pause marker (paused:<lessonId>)", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-session-pause-resume.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate key from the journal because a journal is a transcript the server may lack while a marker is one the server already has; folding them together would lose the pause when the journal clears.", "_origin": "semantic"}, {"id": "docs_2026_08_16_tutor_session_pause_resume_pause_intent_ref", "label": "pauseIntentRef", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-session-pause-resume.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDK reports reason 'user' for both teardowns so intent cannot be read from the transport.", "_origin": "semantic"}, {"id": "hidden_kickoff_messages", "label": "HIDDEN_KICKOFF_MESSAGES", "file_type": "concept", "source_file": "docs/2026-08-16-tutor-session-pause-resume.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every hidden message must join this array or it leaks into stored history via the webhook.", "_origin": "semantic"}], "edges": [{"source": "docs_2026_08_16_tutor_session_pause_resume", "target": "docs_2026_08_16_tutor
{"nodes": [{"id": "docs_2026_09_11_livekit_claude_diy_provider", "label": "Own Voice Pipeline on LiveKit + Claude (research)", "file_type": "document", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buildable and cheaper than ElevenLabs, but the saving only pays off at tens of learners; case below that is control and observability.", "_origin": "semantic"}, {"id": "docs_2026_09_11_livekit_claude_diy_provider_prompt_agnostic_worker", "label": "Backend builds session; worker is prompt-agnostic", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worker never imports apps/web and needs no Supabase key; it writes back through backend routes with a per-lesson HMAC grant.", "_origin": "semantic"}, {"id": "docs_2026_09_11_livekit_claude_diy_provider_custom_claude_adapter", "label": "Own ~300-line Claude LLM adapter", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LiveKit Anthropic plugins lack prompt caching, hoist system messages, and mishandle thinking/temperature/prefill on newer Claude models.", "_origin": "semantic"}, {"id": "docs_2026_09_11_livekit_claude_diy_provider_turn_ledger", "label": "Per-turn ledger (TurnRecord)", "file_type": "concept", "source_file": "docs/2026-09-11-livekit-claude-diy-provider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every Claude call is ours so exact per-turn tokens, cache and latency can be recorded, instead of the overstated estimateCostUsd.", "_origin": "semantic"}, {"id": "docs_2026_09_11_livekit_claude_diy_provide
{
  "name": "english-tutor-monorepo",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter api dev",
    "dev:tutor-web": "pnpm --filter tutor-web dev",
    "dev:feedback": "pnpm --filter feedback-tracker dev",
    "parity:api": "pnpm --filter api parity",
    "build": "pnpm --filter api --filter tutor-web --filter feedback-tracker build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "check:shared": "pnpm --filter @tutor/shared check",
    "db:migrate": "pnpm --filter @tutor/server db:migrate",
    "db:migrate:status": "pnpm --filter @tutor/server db:migrate:status",
    "env:diff": "node scripts/env-sync.mjs diff",
    "env:push": "node scripts/env-sync.mjs push",
    "env:push:apply": "node scripts/env-sync.mjs push --apply",
    "env:pull": "node scripts/env-sync.mjs pull --dry-run",
    "env:pull:apply": "node scripts/env-sync.mjs pull",
    "sync:agents": "pnpm --filter @tutor/server sync:agents",
    "sync:agents:plan": "pnpm --filter @tutor/server sync:agents:plan",
    "level:items": "pnpm --filter @tutor/server level:items",
    "level:items:plan": "pnpm --filter @tutor/server level:items:plan",
    "enrich:words": "pnpm --filter @tutor/server enrich:words",
    "enrich:words:plan": "pnpm --filter @tutor/server enrich:words:plan",
    "lexicon:load": "pnpm --filter @tutor/server lexicon:load",
    "lexicon:load:plan": "pnpm --filter @tutor/server lexicon:load:plan",
    "level:lexicon": "pnpm --filter @tutor/server level:lexicon",
    "level:lexicon:plan": "pnpm --filter @tutor/server level:lexicon:plan",
    "report": "pnpm --filter @tutor/server report",
    "verify:reports": "pnpm --filter @tutor/server verify:reports",
    "mobile": "pnpm --filter mobile start",
    "distribute": "pnpm --filter mobile distribute"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}

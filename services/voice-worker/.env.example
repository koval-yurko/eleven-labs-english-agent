# services/voice-worker — the LiveKit tutor worker. A separate deployable, NOT on Vercel. Locally these
# are read from services/voice-worker/.env (src/env.ts); on LiveKit Cloud they are agent secrets, synced
# by `pnpm env:push --target worker` (scripts/env-sync.mjs → `lk agent update-secrets`).
# Agent secrets are write-only: `pnpm env:pull` can list their names but never restore a value.
# LIVEKIT_URL / _API_KEY / _API_SECRET are never pushed — LiveKit Cloud injects its own.
# See docs/2026-09-11-livekit-claude-diy-provider.md §10.1.

# ── LiveKit — same four values as services/api/.env ──────────────────────────────
# Without the first three the worker still runs in `lk agent console`, but the turn detector
# falls back to the local v1-mini model instead of LiveKit Inference.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=           # secret
LIVEKIT_GRANT_SECRET=         # secret — byte-identical to services/api's copy

# ── The pipeline: each vendor on our own key ─────────────────────────────────
ANTHROPIC_API_KEY=            # secret — own copy of services/api's
DEEPGRAM_API_KEY=             # secret — STT (Deepgram Flux)
ELEVENLABS_API_KEY=           # secret — only stt:check (synthesizes test speech); the tutor's TTS is Deepgram
# The tutor's voice when a lesson names none. Same voice as the ElevenLabs tutor, so the L8
# side-by-side compares the pipeline, not two voices.
ELEVENLABS_TEACHER_VOICE_ID=

# ── TTS candidates (words-4.1 and words-4.2, Qwen Plus) — only needed for the version that uses them ──
# Which profile a lesson uses comes from the version (PromptVersion.tts), see src/tts-profiles.ts.
# docs/2026-10-08-livekit-tts-candidates-qwen-gemini.md §4 says where to get each value.
DASHSCOPE_API_KEY=            # secret — Alibaba Model Studio key; per REGION, must match QWEN_REGION
QWEN_WORKSPACE_ID=            # Model Studio workspace id (part of the WebSocket host)
#QWEN_REGION=                 # ap-southeast-1 (default, Singapore) | cn-beijing
#QWEN_TTS_MODEL=              # default qwen-audio-3.0-tts-plus (3.1 Plus does not exist; 3.1 flash/next: AccessDenied)
#QWEN_TTS_VOICE=              # default longanhuan_v3.6 (voices are model-specific)
#QWEN_TTS_LANGUAGE=           # default en

# ── Voicebox (words-4.3, /tts/ws) — our custom local Voicebox build ──
# Nothing is required for a LOCAL worker: the defaults reach the app on this Mac. A LiveKit Cloud
# worker cannot reach 127.0.0.1; it needs the tunnel URL and a key from scripts/voicebox_api_key.py.
# The two below are synced to the Cloud worker by `pnpm env:push --target worker`, so they are not
# commented out. Leave both empty locally to use the app on this Mac (empty = the default).
VOICEBOX_URL=                 # empty = http://127.0.0.1:17493; Cloud worker: https://tts.<domain> (the tunnel)
VOICEBOX_API_KEY=             # secret — only through the tunnel; local requests need no key
#VOICEBOX_LOCAL_URL=          # words-4.4 (voicebox-local): default http://127.0.0.1:17493; ignores VOICEBOX_URL and the key
#VOICEBOX_PROFILE_ID=         # default 6536ab39-8909-4528-8327-27d61a390e45 ("Men 1"); words-4.3 and words-4.4
#VOICEBOX_MODEL_SIZE=         # default 1.7B (0.6B must be downloaded in Voicebox first)
#VOICEBOX_INTERVAL_MS=        # default 320: audio per model chunk; smaller = earlier first audio
#VOICEBOX_LANGUAGE=           # default en
# Voicebox STT profiles (voicebox-qwen-asr-0.6b, ...): /stt/ws on VOICEBOX_LOCAL_URL, Mac worker only.
# The model is part of the profile name, set in the prompt version (`stt`), never here.
#VOICEBOX_STT_LANGUAGE=       # default empty = detected per segment (learners also answer in Russian)

# ── Which agent name this worker registers as ──
# Unset = `tutor` (the LiveKit Cloud worker). The worker on the Voicebox Mac sets `tutor-local`, so it
# gets only versions with `worker: "local"` (words-4.4). Set it in that process's environment, not
# here: this file also feeds `pnpm env:push --target worker`.
#LIVEKIT_AGENT_NAME=

# Optional overrides. Defaults: flux-general-multi (EN+RU hint) and aura-2-asteria-en.
#DEEPGRAM_MODEL=
#DEEPGRAM_TTS_MODEL=          # an Aura-2 voice, default aura-2-asteria-en

# Only for the Phase 1/2 console, until the token route sends real dispatch metadata.
# Generate from packages/server/ with `pnpm dispatch:fixture > ../../services/voice-worker/.local/dispatch.json`.
#DISPATCH_METADATA_FILE=.local/dispatch.json

# The web origin the worker posts the ledger and transcript to (Phase 3).
# http://localhost:3000 locally, the Vercel origin in production.
API_BASE_URL=

# apps/tutor-web — the (deprecated) learner web UI. A CLIENT of services/api: it holds the Auth0
# web-application settings and the API's URL, and nothing else — no Supabase key, no vendor key
# (D6, docs/2026-10-10-services-split-hono-api.md §5, §7).

# Auth0 web application (shared with feedback-tracker, D9). Add this app's origin to the
# application's Allowed Callback / Logout URLs: <APP_BASE_URL>/auth/callback and <APP_BASE_URL>.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=          # secret
AUTH0_SECRET=                 # secret — session-cookie encryption (openssl rand -hex 32)

# REQUIRED: services/api's audience (its AUTH0_API_AUDIENCE). It is what makes Auth0 issue an
# access token the API accepts; without it every page fails to load data.
AUTH0_AUDIENCE=

APP_BASE_URL=http://localhost:3002
API_BASE_URL=http://localhost:3000     # services/api (`pnpm dev`)

# ── Vercel build ─────────────────────────────────────────────────────────────
# Makes Vercel install the pnpm this package.json names (pnpm@11.20.0) instead of guessing 9.x from
# the lockfile — pnpm 9 silently ignores pnpm-workspace.yaml (nodeLinker, overrides, allowBuilds).
# A build-time switch; nothing reads it at runtime. docs/2026-10-10-services-split-hono-api.md step 5.
ENABLE_EXPERIMENTAL_COREPACK=1

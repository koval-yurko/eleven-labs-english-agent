# Annotations read by `pnpm env:sync` (scripts/env-sync.mjs):
#
#   # secret       this value is a credential. Documentation only — it does NOT change how the
#                  value is stored, and it is never printed by the tool either way.
#   # write-only   store it as Vercel `sensitive`. Vercel will then refuse to read it back on
#                  production, so `pnpm env:pull` can never restore it to a new machine and you
#                  must keep it somewhere else. Nothing uses this today, on purpose: the point
#                  of the sync is that a fresh laptop can be rebuilt from production.
#   #KEY=          known key, never synced in either direction (a value that must differ
#                  between laptop and production, or one that is retired).

#APP_BASE_URL=         # differs: localhost vs the deployed origin
#APP_ENV=              # differs: dev vs prod

# ── Auth0 (login) ────────────────────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=          # secret
AUTH0_SECRET=                 # secret — session-cookie encryption (openssl rand -hex 32)

# LEAVE EMPTY. Read by lib/auth0.ts; setting it changes the WEB login flow (adds
# authorizationParameters). It belongs to the Supabase-RLS path, which this project is not on.
# The mobile Bearer path uses AUTH0_API_AUDIENCE below instead. See
# docs/2026-08-13-expo-s2-auth0-bearer.md §4.2.
#AUTH0_AUDIENCE=       # deliberately unset — see the note above

# Verification only — the /api/v2 Bearer path (mobile). The Auth0 API "Identifier" string,
# matched byte-for-byte against the token's `aud` claim. Never fetched; it needs no DNS.
AUTH0_API_AUDIENCE=

# ── Supabase (Postgres) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # secret — bypasses RLS, server only
SUPABASE_DB_URL=              # secret — direct Postgres superuser connection

# ── Anthropic Claude (via LangChain) ─────────────────────────────────────────
ANTHROPIC_API_KEY=            # secret
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=claude-opus-4-5

# ── ElevenLabs (English words tutor agent) ───────────────────────────────────
ELEVENLABS_API_KEY=           # secret
ELEVENLABS_TEACHER_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=    # secret
ELEVENLABS_WEBHOOK_FORWARD_URL=

# LIVE_STORY_LLM=
# LIVE_STORY_TTS_MODEL=

# ── OpenAI Realtime (STAGE 0 SPIKE — the second tutor provider) ──────────────
# Only /api/v2/words-agent/openai-token reads these. Unset = the spike route 500s and
# nothing else in the app notices. See docs/2026-08-22-openai-realtime-second-provider.md.
OPENAI_API_KEY=               # secret
# Defaults to gpt-realtime; set gpt-realtime-mini to price-check §10.
OPENAI_REALTIME_MODEL=
# One of OpenAI's fixed voices (marin, cedar, alloy, …). Defaults to marin.
OPENAI_REALTIME_VOICE=

# ── LangSmith (tracing) ──────────────────────────────────────────────────────
LANGSMITH_API_KEY=            # secret
LANGSMITH_PROJECT=idiomatic

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=

# ── Our own MCP server (/api/mcp — the tutor saves words) ────────────────────
# An OVERRIDE, not the source, for the two providers whose grant is PROVISIONED (ElevenLabs
# registrations, Vapi assistants): those are written with the deployed origin unless you pass
# `pnpm sync:agents --allow-dev-mcp-url`, because each vendor account is shared with production
# and a tunnel written into a live agent dies with the tunnel. OpenAI is the opposite — its
# token route REQUIRES this, since it bakes the URL into each minted session.
# See `DEPLOYED_MCP_URL` in src/agent/mcp-url.ts.
MCP_PUBLIC_URL=
# The shared secret /api/mcp verifies (lib/mcp/auth.ts). <32 chars is treated as unset and
# every request is rejected. Read on TWO paths that hand it to a vendor: the OpenAI token route
# (per session) and `pnpm sync:agents`, which writes it into a Vapi assistant's request headers
# — Vapi has no secret store, so without it that provider is skipped rather than patched.
# ElevenLabs never reads it: it holds its own copy as the MCP_AUTHORIZATION_HEADER workspace
# secret, which must be rotated BEFORE this value and holds the full "Bearer <token>" string.
MCP_TOKEN=                    # secret
#MCP_TOKEN_OLD=        # rotation leftover, local only

# ── Vapi (the third tutor provider) ──────────────────────────────────────────
# PRIVATE provisions assistants and mints calls (server only); PUBLIC is what a client SDK is
# constructed with; ORG_ID only signs short-lived client JWTs. WEBHOOK_ORIGIN + _SECRET are
# where `end-of-call-report` is delivered, provisioned onto each assistant — both halves or
# neither. See docs/2026-08-27-vapi-third-voice-provider.md.
VAPI_PRIVATE_KEY=            # secret
VAPI_PUBLIC_KEY=
VAPI_ORG_ID=
VAPI_WEBHOOK_ORIGIN=
VAPI_WEBHOOK_SECRET=          # secret

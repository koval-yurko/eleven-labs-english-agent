APP_BASE_URL=http://localhost:3000
# APP_ENV=prod

# ── Auth0 (login) ────────────────────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=          # secret
AUTH0_SECRET=                 # secret — session-cookie encryption (openssl rand -hex 32)

# LEAVE EMPTY. Read by lib/auth0.ts; setting it changes the WEB login flow (adds
# authorizationParameters). It belongs to the Supabase-RLS path, which this project is not on.
# The mobile Bearer path uses AUTH0_API_AUDIENCE below instead. See
# docs/2026-08-13-expo-s2-auth0-bearer.md §4.2.
AUTH0_AUDIENCE=

# Verification only — the /api/v2 Bearer path (mobile). The Auth0 API "Identifier" string,
# matched byte-for-byte against the token's `aud` claim. Never fetched; it needs no DNS.
AUTH0_API_AUDIENCE=

# ── Supabase (Postgres) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # secret — bypasses RLS, server only
SUPABASE_DB_URL=

# ── Anthropic Claude (via LangChain) ─────────────────────────────────────────
ANTHROPIC_API_KEY=            # secret
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=claude-opus-4-5

# ── ElevenLabs (English words tutor agent) ───────────────────────────────────
ELEVENLABS_API_KEY=           # secret
ELEVENLABS_TEACHER_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_WEBHOOK_FORWARD_URL=

# LIVE_STORY_LLM=
# LIVE_STORY_TTS_MODEL=

# ── OpenAI Realtime (STAGE 0 SPIKE — the second tutor provider) ──────────────
# Only /api/v2/words-agent/openai-token reads these. Unset = the spike route 500s and
# nothing else in the app notices. See docs/2026-08-22-openai-realtime-second-provider.md.
OPENAI_API_KEY=               # secret
# Defaults to gpt-realtime; set gpt-realtime-mini to price-check §10.
OPENAI_REALTIME_MODEL=
# One of OpenAI's fixed voices (marin, cedar, alloy, …). Defaults to marin.
OPENAI_REALTIME_VOICE=

# ── LangSmith (tracing) ──────────────────────────────────────────────────────
LANGSMITH_API_KEY=            # secret
LANGSMITH_PROJECT=idiomatic

LANGSMITH_TRACING=true

# ── MCP server (/api/mcp) ────────────────────────────────────────────────────
# Authorization is ONE SHARED SECRET, not OAuth. See docs/2026-08-27-mcp-static-token-auth.md.
#
# The secret every MCP client presents as `Authorization: Bearer <token>`.
# Generate with:  openssl rand -hex 32     (64 hex chars — no delimiter, no shell escaping)
# Shorter than 32 characters is treated as UNSET: the server then rejects every request.
MCP_TOKEN=                    # secret

# There is NO owner variable. MCP writes are anonymous — `words.owner_id` is NULL — because the
# token authenticates a caller, not a person (0018_unowned_words.sql). Unowned words are visible to
# every learner and are levelled and enriched like any other.

# Set ONLY during a rotation: the outgoing secret, accepted alongside MCP_TOKEN until every client
# has moved over. Its presence here means a rotation is half-finished. Delete it to complete one.
MCP_TOKEN_OLD=                # secret

# ─────────────────────────────────────────────────────────────────────────────
# Idiomatic — apps/web (Next.js) environment template.
# Copy to `apps/web/.env.local` and fill in. Next.js loads env from THIS package
# directory (cwd of `next dev`), NOT the monorepo root.
#
# Rule: only NEXT_PUBLIC_* values are shipped to the browser. Everything else is
# server-only — never expose secrets to the client (Constitution V).
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC (shipped to the browser) ──────────────────────────────────────────
# Supabase project URL — also used by the server service client.
NEXT_PUBLIC_SUPABASE_URL=
# Anon (RLS-scoped) key. Safe in the browser. Not yet used by apps/web — the app
# currently uses only the server-side service-role client. Set when adding a
# browser Supabase client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── PRIVATE: Auth0 (read by @auth0/nextjs-auth0 — lib/auth0.ts) ───────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=          # secret
AUTH0_SECRET=                 # secret — session-cookie encryption (openssl rand -hex 32)
APP_BASE_URL=http://localhost:3000

# ── PRIVATE: Supabase server access (lib/supabase/server.ts) ──────────────────
SUPABASE_SERVICE_ROLE_KEY=    # secret — bypasses RLS, server only
SUPABASE_AUDIO_BUCKET=lesson-audio

# ── PRIVATE: generation providers (lib/generation/deps.ts — real adapters) ────
# Absent keys fall back to deterministic mocks so the app runs locally without them.
ANTHROPIC_API_KEY=            # secret
GENERATION_MODEL_ID=claude-sonnet-4-6
ELEVENLABS_API_KEY=           # secret
# Teacher voice is FIXED and reused by the live tutor — voice consistency (Constitution I).
ELEVENLABS_TEACHER_VOICE_ID=
ELEVENLABS_LEARNER_VOICE_ID=

# ── PRIVATE: live tutor (005-live-tutor-qa — lib/live-tutor/*) ─────────────────
# The provisioned ElevenLabs Conversational AI agent for live Q&A. Provision it once
# with the teacher voice (ELEVENLABS_TEACHER_VOICE_ID) + a native Claude LLM (Haiku
# 4.5). Live Q&A is FEATURE-GATED: if ELEVENLABS_API_KEY or ELEVENLABS_AGENT_ID is
# missing, the player shows an "unavailable" fallback and the lesson still plays.
ELEVENLABS_AGENT_ID=

# ── PRIVATE: observability (optional locally) ─────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ── PRIVATE: generation tuning (lib/generation/deps.ts, all optional) ─────────
MAX_TEACHABLE_ITEMS=20
TARGET_MIN_SECONDS=300
TARGET_MAX_SECONDS=600
GENERATION_WPM=150
TTS_CHAR_LIMIT=3000

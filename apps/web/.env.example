# ─────────────────────────────────────────────────────────────────────────────
# Idiomatic — apps/web (Next.js) environment template.
# Copy to `apps/web/.env.local` and fill in. Next.js loads env from THIS package
# directory (cwd of `next dev`), NOT the monorepo root.
#
# Rule: only NEXT_PUBLIC_* values are shipped to the browser. Everything else is
# server-only — never expose secrets to the client (Constitution V).
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC (shipped to the browser) ──────────────────────────────────────────
# Supabase project URL — also used by the server service client.
NEXT_PUBLIC_SUPABASE_URL=
# Anon (RLS-scoped) key. Safe in the browser. Not yet used by apps/web — the app
# currently uses only the server-side service-role client. Set when adding a
# browser Supabase client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── PRIVATE: Auth0 (read by @auth0/nextjs-auth0 — lib/auth0.ts) ───────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=          # secret
AUTH0_SECRET=                 # secret — session-cookie encryption (openssl rand -hex 32)
APP_BASE_URL=http://localhost:3000

# ── PRIVATE: Supabase server access (lib/supabase/server.ts) ──────────────────
SUPABASE_SERVICE_ROLE_KEY=    # secret — bypasses RLS, server only
SUPABASE_AUDIO_BUCKET=lesson-audio

# ── PRIVATE: generation providers (lib/generation/deps.ts — real adapters) ────
# Absent keys fall back to deterministic mocks so the app runs locally without them.
ANTHROPIC_API_KEY=            # secret
GENERATION_MODEL_ID=claude-sonnet-4-6
ELEVENLABS_API_KEY=           # secret
# Teacher voice is FIXED and reused by the live tutor — voice consistency (Constitution I).
ELEVENLABS_TEACHER_VOICE_ID=
ELEVENLABS_LEARNER_VOICE_ID=

# ── PRIVATE: live tutor (005-live-tutor-qa — lib/live-tutor/*) ─────────────────
# The provisioned ElevenLabs Conversational AI agent for live Q&A. Provision it once
# with the teacher voice (ELEVENLABS_TEACHER_VOICE_ID) + a native Claude LLM (Haiku
# 4.5). Live Q&A is FEATURE-GATED: if ELEVENLABS_API_KEY or ELEVENLABS_AGENT_ID is
# missing, the player shows an "unavailable" fallback and the lesson still plays.
ELEVENLABS_AGENT_ID=
# Optional overrides for `pnpm provision:agent` (scripts/create-live-tutor-agent.ts).
# Defaults: LLM = claude-haiku-4-5, TTS = eleven_flash_v2 (English agents require an
# English v2 model — flash/turbo v2; v2.5/v3 are rejected/gated). Leave blank to use defaults.
LIVE_TUTOR_LLM=
LIVE_TUTOR_TTS_MODEL=

# ── PRIVATE: live story (006-adaptive-live-story — @idiomatic/live-story) ──────
# A SEPARATE provisioned ElevenLabs Conversational AI agent for the adaptive,
# interruptible live-narrated lesson (distinct from the 005 ELEVENLABS_AGENT_ID so
# each prompt/tool set is tuned independently — research R10). Provision it once with
# the SAME teacher voice (ELEVENLABS_TEACHER_VOICE_ID) + a native Claude LLM (Haiku 4.5)
# and the four client tools declared (advanceNarration, markItemTaught, setScenario,
# concludeLesson). Run `pnpm provision:story-agent` (packages/live-story/scripts/
# create-live-story-agent.ts), then paste the printed id below. Overridable with
# LIVE_STORY_LLM / LIVE_STORY_TTS_MODEL. See packages/live-story/README.md.
#
# Live Story is FEATURE-GATED: if ELEVENLABS_API_KEY or ELEVENLABS_STORY_AGENT_ID is
# missing, the Live Story UI shows a clear "unavailable" panel with retry/try-later —
# never a blank/frozen screen (FR-026). No NEW client dependency is required —
# @elevenlabs/react (installed in 005) provides clientTools/sendContextualUpdate/
# onMessage/onAgentResponseCorrection. Reused server-side: ELEVENLABS_API_KEY (mints
# conversation tokens), ELEVENLABS_TEACHER_VOICE_ID (must equal the story agent's
# voice), TARGET_MIN_SECONDS / TARGET_MAX_SECONDS (clamp the plan's target length, R8).
ELEVENLABS_STORY_AGENT_ID=

# ── PRIVATE: observability (optional locally) ─────────────────────────────────
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=

# Live-story session tracing (008-langsmith-tracing). All SERVER-ONLY and soft: with no
# LANGSMITH_API_KEY the OTel relay no-ops and the self-reported tracer still emits a per-turn
# trace. The webhook rejects every post until ELEVENLABS_CONVAI_WEBHOOK_SECRET is set; the
# sweep route rejects every call until CRON_SECRET is set (Vercel cron injects it).
ELEVENLABS_CONVAI_WEBHOOK_SECRET=
CRON_SECRET=
LIVE_STORY_SWEEP_IDLE_MINUTES=10
LIVE_STORY_SWEEP_BATCH_LIMIT=100


# ── PRIVATE: generation tuning (lib/generation/deps.ts, all optional) ─────────
MAX_TEACHABLE_ITEMS=20
TARGET_MIN_SECONDS=300
TARGET_MAX_SECONDS=600
GENERATION_WPM=150
TTS_CHAR_LIMIT=3000

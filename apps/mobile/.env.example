# apps/mobile — runtime configuration.
#
# COPY TO .env AND FILL IN. `.env` is gitignored; this file is the committed record of WHICH
# variables exist, never of their values.
#
# Where each value comes from:
#   local `expo start` / `expo run:ios`  → this .env
#   EAS cloud build                      → EAS environment variables, chosen by the build profile's
#                                          `environment` field in eas.json:
#     eas env:set --name EXPO_PUBLIC_AUTH0_DOMAIN --value ... --environment preview --visibility plaintext
#
# EXPO_PUBLIC_ is a statement of fact: every value below is embedded in the app manifest and can be
# read out of the .ipa. Keeping them out of git is hygiene, not confidentiality. Nothing that is
# genuinely secret may ever appear here — the server holds those (creation doc §3.5).

# Which identity to build. Unset means production; local work should say development so a local
# build never overwrites a TestFlight install. See the S0 doc §2 (D7).
APP_VARIANT=development

# ── S2: Auth0 ────────────────────────────────────────────────────────────────
# Tenant domain, e.g. your-tenant.eu.auth0.com
EXPO_PUBLIC_AUTH0_DOMAIN=
# The NATIVE application's client id — a public client (PKCE, no secret), separate from the web app.
EXPO_PUBLIC_AUTH0_CLIENT_ID=
# The Auth0 API "Identifier". Matched byte-for-byte against the server's AUTH0_API_AUDIENCE.
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Origin of the /api/v2/* routes, no trailing slash — every native call is built from this plus a
# path from API_V2_ROUTES. The app throws naming this variable on first use rather than pointing
# at nothing, so an unset value fails loudly instead of producing relative requests.
EXPO_PUBLIC_API_BASE_URL=

EXPO_PUBLIC_VAPI_PUBLIC_KEY=
EXPO_PUBLIC_VAPI_ASSISTANT_ID=

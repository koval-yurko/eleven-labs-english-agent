{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@elevenlabs/react-native": "1.2.18",
    "@expo/ui": "~57.0.11",
    "@livekit/react-native": "2.9.8",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "137.0.3",
    "@tutor/shared": "workspace:*",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "livekit-client": "2.16.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-auth0": "^5.11.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "^1.20.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:expo": "expo-doctor",
    "bundle": "expo export --platform ios",
    "check": "pnpm typecheck && pnpm lint && pnpm check:expo && pnpm bundle",
    "native": "expo prebuild --clean --platform ios",
    "device": "expo run:ios --device",
    "device:release": "expo run:ios --device --configuration Release",
    "device:register": "npx eas-cli device:create",
    "build:dev": "npx eas-cli build --platform ios --profile development",
    "build:preview": "npx eas-cli build --platform ios --profile preview",
    "build:prod": "npx eas-cli build --platform ios --profile production",
    "submit": "npx eas-cli submit --platform ios --latest",
    "testflight": "npx eas-cli build --platform ios --profile production --auto-submit"
  },
  "private": true
}

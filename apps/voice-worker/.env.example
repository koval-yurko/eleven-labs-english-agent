# apps/voice-worker — the LiveKit tutor worker. A separate deployable, NOT on Vercel. Locally these
# are read from apps/voice-worker/.env (src/env.ts); on LiveKit Cloud they are agent secrets, synced
# by `pnpm env:push --target worker` (scripts/env-sync.mjs → `lk agent update-secrets`).
# Agent secrets are write-only: `pnpm env:pull` can list their names but never restore a value.
# LIVEKIT_URL / _API_KEY / _API_SECRET are never pushed — LiveKit Cloud injects its own.
# See docs/2026-09-11-livekit-claude-diy-provider.md §10.1.

# ── LiveKit — same four values as apps/web/.env ──────────────────────────────
# Without the first three the worker still runs in `lk agent console`, but the turn detector
# falls back to the local v1-mini model instead of LiveKit Inference.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=           # secret
LIVEKIT_GRANT_SECRET=         # secret — byte-identical to apps/web's copy

# ── The pipeline: each vendor on our own key ─────────────────────────────────
ANTHROPIC_API_KEY=            # secret — own copy of apps/web's
DEEPGRAM_API_KEY=             # secret — STT (Deepgram Flux)
ELEVENLABS_API_KEY=           # secret — TTS, own copy of apps/web's
# The tutor's voice when a lesson names none. Same voice as the ElevenLabs tutor, so the L8
# side-by-side compares the pipeline, not two voices.
ELEVENLABS_TEACHER_VOICE_ID=

# Optional overrides. Defaults: flux-general-multi (EN+RU hint) and eleven_flash_v2_5.
#DEEPGRAM_MODEL=
#ELEVENLABS_TTS_MODEL=

# Only for the Phase 1/2 console, until the token route sends real dispatch metadata.
# Generate with `pnpm --filter web dispatch:fixture > ../voice-worker/.local/dispatch.json`.
#DISPATCH_METADATA_FILE=.local/dispatch.json

# The web origin the worker posts the ledger and transcript to (Phase 3).
# http://localhost:3000 locally, the Vercel origin in production.
API_BASE_URL=

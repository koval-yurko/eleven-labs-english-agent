# apps/feedback-tracker — the operator's debug-report triage. A CLIENT of services/api: Auth0
# web-application settings and the API's URL, nothing else (D6, docs/2026-10-10-services-split-hono-api.md §6, §7).
# It reads EVERY learner's reports — D10, an accepted risk (§6.1).

# Auth0 web application (the same one tutor-web uses, D9). Add this app's origin to the
# application's Allowed Callback / Logout URLs: <APP_BASE_URL>/auth/callback and <APP_BASE_URL>.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=          # secret
AUTH0_SECRET=                 # secret — session-cookie encryption (openssl rand -hex 32)

# REQUIRED: services/api's audience (its AUTH0_API_AUDIENCE).
AUTH0_AUDIENCE=

APP_BASE_URL=http://localhost:3003
API_BASE_URL=http://localhost:3000     # services/api (`pnpm dev`)

# Optional: tutor-web's origin, so a report's lesson id links to the lesson page.
TUTOR_WEB_URL=http://localhost:3002

# ── Vercel build ─────────────────────────────────────────────────────────────
# Makes Vercel install the pnpm this package.json names (pnpm@11.20.0) instead of guessing 9.x from
# the lockfile — pnpm 9 silently ignores pnpm-workspace.yaml (nodeLinker, overrides, allowBuilds).
# A build-time switch; nothing reads it at runtime. docs/2026-10-10-services-split-hono-api.md step 5.
ENABLE_EXPERIMENTAL_COREPACK=1

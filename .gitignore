### Node
# Dependencies
node_modules/
.claude/worktrees

# Logs
*.log

# Build output
dist/
build/Release

# TypeScript cache
*.tsbuildinfo

# Framework build output and caches
.cache
.parcel-cache
.next
out/
.nuxt
next-env.d.ts

# dotenv environment variable files
.env
.env.local
.env.*.local

# npm cache directory
.npm
*.tgz

# Test coverage
coverage/

# Playwright (T050)
test-results/
playwright-report/
playwright/.cache/
blob-report/

# OS / editor
.DS_Store
.idea

# Expo (apps/mobile) — generated native projects and caches
credentials/
credentials.json
.expo/
apps/mobile/ios/
apps/mobile/android/
.vercel
.env*
# Templates are committed. apps/web and apps/mobile were force-added before this line existed.
!.env.example

# Lexicon build inputs (~21 MB: WikDict SQLite + CEFR CSVs). Fetched on demand, never
# committed — see apps/web/scripts/lexicon/README.md. Only the derived data/ artifact ships.
apps/web/scripts/lexicon/sources/

# Message Batch manifests — they name a batch on Anthropic's side and mean nothing in
# anyone else's checkout. See apps/web/scripts/level-lexicon.ts.
apps/web/scripts/lexicon/.batches/

# graphify code map — graph.json/graph.html/cache/ast are derived and regenerable in any
# checkout (see docs/2026-09-19-graffiti-to-graphify-design.md §6). cache/semantic*/ is the
# exception: it holds LLM-extracted doc summaries that cost money to recreate, so it is
# re-included below. Nested re-inclusion is required — a flat negation after `graphify-out/`
# stages nothing, silently.
graphify-out/*
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/
!graphify-out/cache/semantic-deep/

# graffiti code map (superseded by graphify above) — left ignored until the sibling doc's
# gates are run and the graffiti skill/binary are actually removed (D12).
.graffiti/

# apps/voice-worker's manual-walkthrough fixture (`pnpm dispatch:fixture` in apps/web, see
# apps/voice-worker/src/agent.ts) — a local JSON dump of a real prompt, regenerable on demand
# and meaningless outside the checkout that made it.
apps/voice-worker/.local/

# `lk agent console --record` writes the lesson's audio and session report here. It is a recording
# of a real person's voice, megabytes per walkthrough, and regenerable by running the walkthrough
# again — three separate reasons it does not belong in the repo. One was committed by accident on
# 2026-09-25 and rewritten out of the branch before it was pushed; this is so that cannot recur.
apps/voice-worker/console-recordings/

# Local package-manager cache
.pnpm-store/

# ─────────────────────────────────────────────────────────────────────────────
# Idiomatic — environment template. Copy to .env.local (or .env) and fill.
# Next.js loads env from the project root (cwd of `next dev`).
# Only NEXT_PUBLIC_* values are shipped to the browser. Everything else is
# server-only — never expose secrets to the client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth0 (login) ────────────────────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=          # secret
AUTH0_SECRET=                 # secret — session-cookie encryption (openssl rand -hex 32)
APP_BASE_URL=http://localhost:3000
# Optional: your Auth0 API identifier, to issue JWT access tokens for Supabase
# third-party auth / RLS. Leave blank until the Auth0 API + Supabase trust are
# configured — see supabase/README.md.
AUTH0_AUDIENCE=

# ── Supabase (Postgres) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # secret — bypasses RLS, server only
# Postgres connection string for `pnpm db:migrate` (DB password, NOT the service_role key).
# Supabase → Project Settings → Database → Connection string → "URI".
SUPABASE_DB_URL=

# ── Anthropic Claude (via LangChain) ─────────────────────────────────────────
ANTHROPIC_API_KEY=            # secret
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=claude-opus-4-5

# ── ElevenLabs (English words tutor agent) ───────────────────────────────────
ELEVENLABS_API_KEY=           # secret
# Teacher voice is FIXED and reused by the tutor (voice consistency).
ELEVENLABS_TEACHER_VOICE_ID=
# The provisioned tutor agent id. Create it once with `pnpm provision:agent`
# (src/agent/create-agent.ts), then paste the printed id here.
ELEVENLABS_STORY_AGENT_ID=
# Optional overrides for `pnpm provision:agent` (defaults: LLM claude-sonnet-4-6,
# TTS eleven_flash_v2 — English agents require an English v2 model).
LIVE_STORY_LLM=
LIVE_STORY_TTS_MODEL=

# ── LangSmith (optional tracing) ─────────────────────────────────────────────
# When set, LangChain auto-traces every Claude call to LangSmith. No-op when unset.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=idiomatic
LANGCHAIN_TRACING_V2=false

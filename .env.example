# ─────────────────────────────────────────────────────────────────────────────
# Idiomatic — environment template. Copy to .env.local and fill.
# ALL of these are server-only. Never expose secrets to the browser (Constitution V).
# Only NEXT_PUBLIC_* values are safe to ship to the client.
# ─────────────────────────────────────────────────────────────────────────────

# Auth0 (identity — FR-017)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Optional: set to your Auth0 API identifier to issue JWT access tokens for Supabase
# third-party auth / RLS (T037). Leave blank until the Auth0 API + Supabase trust are
# configured — see supabase/README.md §T037.
AUTH0_AUDIENCE=

# Supabase (Postgres + private Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=lesson-audio
# Postgres connection string for `pnpm db:migrate` (DB password, NOT the service_role key).
# Supabase → Project Settings → Database → Connection string → "URI".
# If IPv4-only network, use the "Session pooler" string (port 5432) instead.
SUPABASE_DB_URL=

# Anthropic Claude (generation brain)
ANTHROPIC_API_KEY=
GENERATION_MODEL_ID=claude-sonnet-4-6

# ElevenLabs (scripted audio — Text to Dialogue / Eleven v3)
ELEVENLABS_API_KEY=
# Teacher voice is FIXED and reused by the live tutor (S2) — Constitution I voice consistency.
ELEVENLABS_TEACHER_VOICE_ID=
ELEVENLABS_LEARNER_VOICE_ID=

# ElevenLabs Agents — live tutor Q&A (005-live-tutor-qa). The provisioned agent id;
# configure it with the teacher voice + a native Claude LLM (Haiku 4.5). Live Q&A is
# feature-gated on ELEVENLABS_API_KEY + ELEVENLABS_AGENT_ID being present.
ELEVENLABS_AGENT_ID=

# LangSmith (generation eval/observability — Constitution III). Optional locally.
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Generation tuning (research R1/R3)
MAX_TEACHABLE_ITEMS=20
TARGET_MIN_SECONDS=300
TARGET_MAX_SECONDS=600
# TTS_CHAR_LIMIT: per-request character ceiling for Text to Dialogue (default 3000).
TTS_CHAR_LIMIT=3000

# TTS batch render concurrency (004-tts-parallel-render). Max ElevenLabs Text-to-Dialogue
# batch renders in flight at once. Keep at/UNDER your plan's concurrency limit to avoid 429s:
#   Free 2 · Starter 3 · Creator 5 · Pro 10 · Scale/Business 15.
# Default is 3 (safe for Starter and above) — Free-tier MUST set 2. Set 1 for sequential.
# Invalid/blank values fall back to the default.
TTS_BATCH_CONCURRENCY=3

# Internal structured logging (003-internal-logging). Logs the generation pipeline to
# stdout as newline-delimited JSON, correlated by lesson id. Secrets are always redacted.
# LOG_LEVEL: debug | info | warn | error (default: info). `debug` additionally emits raw
# learner item text and draft/prompt bodies — use only when debugging a bad lesson.
LOG_LEVEL=info
# LOG_PRETTY: set to 1 for human-readable lines in local dev (default: raw NDJSON).
LOG_PRETTY=

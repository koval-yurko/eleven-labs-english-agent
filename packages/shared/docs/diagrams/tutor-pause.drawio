xCell><mxCell id="n9" value=" 6 Learner: got it, thanks.&#10; 7 Teacher: Good. Next one.&#10;   ▲ Pause pressed. Tutor was listening." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F0F0F2;strokeColor=#8A8A93;fontColor=#3A3A40;fontSize=12;fontFamily=Courier New;strokeWidth=1.5;verticalAlign=middle;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="64" width="320" height="100" as="geometry"/></mxCell><mxCell id="n10" value="planHold →&#10;  aborted = false&#10;  atLine  = 8&#10;  nothing after line 8" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#FDF1DC;strokeColor=#B9791B;fontColor=#3D2708;fontSize=12;fontFamily=Courier New;strokeWidth=1.5;verticalAlign=middle;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="184" width="320" height="124" as="geometry"/></mxCell><mxCell id="n11" value="planRelease →&#10;  say = null&#10;&#10;The tutor says nothing extra —&#10;only the resume context." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#E4F1E8;strokeColor=#2E7D4F;fontColor=#10301F;fontSize=12;fontFamily=Courier New;strokeWidth=1.5;verticalAlign=middle;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="720" y="328" width="320" height="130" as="geometry"/></mxCell><mxCell id="n12" value="All three also:  setMicMuted(snapshot.wasMuted) · setOutputSilenced(false) · context(formatHeldResumeContext(secs))&#10;&#10;The gap is reported to the tutor, never used to decide — planRelease reads the transcript, not the clock." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F0F0F2;strokeColor=#8A8A93;fontColor=#3A3A40;fontSize=12;fontFamily=Courier New;strokeWidth=1.5;verticalAlign=middle;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="492" width="1020" height="72" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;jettySize=auto;strokeColor=#5A6472;strok
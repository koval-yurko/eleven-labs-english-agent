ing=6;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="220" height="64" as="geometry"/></mxCell><mxCell id="n10" value="R1 createLesson L1 → upsert by id → same row&#10;R2 addItems I5 I6  → upsert by id → same rows&#10;R3 addItems I7     → applied now&#10;&#10;FlushResult.applied = [R1, R2, R3]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#E4F1E8;strokeColor=#2E7D4F;fontColor=#10301F;fontSize=12;fontFamily=Courier New;strokeWidth=1.5;verticalAlign=middle;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="600" y="370" width="440" height="124" as="geometry"/></mxCell><mxCell id="n11" value="deleteOutbox(applied) removes exactly those three. Every id was minted on the device, so replaying&#10;R1 and R2 is a no-op — which is why a half-delivered flush needs no reconciliation." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F0F0F2;strokeColor=#8A8A93;fontColor=#3A3A40;fontSize=12;fontFamily=Courier New;strokeWidth=1.5;verticalAlign=middle;spacing=6;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1020" height="70" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;jettySize=auto;strokeColor=#5A6472;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#33404F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;jettySize=auto;strokeColor=#5A6472;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#33404F;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;exitX=0.25;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;ht
{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The PURE CORE only (src/**). Its portability is a checked property, not an assumed one:
  //   - `types: []` means no ambient @types are pulled in, so a `node:*` import here is a hard error
  //     even though @types/node is installed for the check harness (tsconfig.check.json).
  //   - `lib` deliberately omits DOM.Iterable — the core may construct a URLSearchParams but not
  //     iterate one, because that is where the platform differences start.
  // DOM is present for URLSearchParams itself, not because this code runs in a browser.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    // Must match apps/web. Dropping it would let an edit pass `pnpm -r typecheck` and fail the app build.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}

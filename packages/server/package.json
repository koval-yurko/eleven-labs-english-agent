{
  "name": "@tutor/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./agent/prompts": "./src/agent/prompts/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "sync:agents": "tsx src/agent/sync-agents.ts",
    "sync:agents:plan": "tsx src/agent/sync-agents.ts --dry-run",
    "level:items": "tsx scripts/level-items.ts",
    "level:items:plan": "tsx scripts/level-items.ts --dry-run",
    "enrich:words": "tsx scripts/enrich-words.ts",
    "enrich:words:plan": "tsx scripts/enrich-words.ts --dry-run",
    "lexicon:load": "tsx scripts/lexicon/load-lexicon.ts",
    "lexicon:load:plan": "tsx scripts/lexicon/load-lexicon.ts --dry-run",
    "level:lexicon": "tsx scripts/level-lexicon.ts",
    "level:lexicon:plan": "tsx scripts/level-lexicon.ts --dry-run",
    "dispatch:fixture": "tsx scripts/livekit-dispatch-fixture.ts",
    "report": "tsx scripts/report.ts",
    "verify:reports": "tsx scripts/verify-debug-reports.ts",
    "livekit:cost": "tsx scripts/livekit-cost.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/supabase-js": "^2.107.0",
    "@tutor/shared": "workspace:*",
    "jose": "^6.2.8",
    "langsmith": "^0.7.12",
    "pg": "^8.13.1",
    "zod": "^3.25.76",
    "zod4": "npm:zod@^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
